  "legalGizlilikB1": "This policy explains what information the GÜ Kulüpler app collects and how it is used.",
  "@legalGizlilikB1": {
    "description": "Key legal.gizlilik.b1"
  },
  "legalGizlilikB2": "Your account is created with your university email; the email is visible only to club managers.",
  "@legalGizlilikB2": {
    "description": "Key legal.gizlilik.b2"
  },
  "legalGizlilikB3": "Your profile is visible only to shared-club members and club managers. Department and year are not public.",
  "@legalGizlilikB3": {
    "description": "Key legal.gizlilik.b3"
  },
  "legalGizlilikB4": "You can change notification preferences any time in Settings. Quiet hours are applied on your device.",
  "@legalGizlilikB4": {
    "description": "Key legal.gizlilik.b4"
  },
  "legalGizlilikB5": "The app uses local storage only to keep your session; there are no third-party ad trackers.",
  "@legalGizlilikB5": {
    "description": "Key legal.gizlilik.b5"
  },
  "legalGizlilikB6": "Blocked users are not informed. Reports are reviewed confidentially by campus administration.",
  "@legalGizlilikB6": {
    "description": "Key legal.gizlilik.b6"
  },
  "legalGizlilikB7": "Significant changes to this policy are announced with an in-app notification.",
  "@legalGizlilikB7": {
    "description": "Key legal.gizlilik.b7"
  },
