  "legalKosullarB1": "By using the app you accept these terms and the community rules.",
  "@legalKosullarB1": {
    "description": "Key legal.kosullar.b1"
  },
  "legalKosullarB2": "The app is available only to students and staff with a valid university email.",
  "@legalKosullarB2": {
    "description": "Key legal.kosullar.b2"
  },
  "legalKosullarB3": "Harassment, hate speech, spam and misleading content are prohibited. Violations may lead to content removal or account suspension.",
  "@legalKosullarB3": {
    "description": "Key legal.kosullar.b3"
  },
  "legalKosullarB4": "Club managers are responsible for application decisions and the content they share; they may send at most 2 announcement notifications per day.",
  "@legalKosullarB4": {
    "description": "Key legal.kosullar.b4"
  },
  "legalKosullarB5": "If you cannot attend an event you registered for, you are expected to leave so your spot goes to the waitlist.",
  "@legalKosullarB5": {
    "description": "Key legal.kosullar.b5"
  },
  "legalKosullarB6": "Icons are from Lucide (ISC) and fonts are Montserrat and Inter (SIL OFL).",
  "@legalKosullarB6": {
    "description": "Key legal.kosullar.b6"
  },
  "legalKosullarB7": "The app is provided \"as is\"; the relevant club is responsible for the content of its events.",
  "@legalKosullarB7": {
    "description": "Key legal.kosullar.b7"
  },
