  "legalKvkkB1": "Your personal data is processed by Gümüşhane University as the data controller under Law No. 6698 (KVKK).",
  "@legalKvkkB1": {
    "description": "Key legal.kvkk.b1"
  },
  "legalKvkkB2": "Name, university email, department, year, interests and event attendance records are processed. Location and contacts are not collected.",
  "@legalKvkkB2": {
    "description": "Key legal.kvkk.b2"
  },
  "legalKvkkB3": "Data is processed to manage club memberships, event registration and attendance, deliver announcements and keep the service secure.",
  "@legalKvkkB3": {
    "description": "Key legal.kvkk.b3"
  },
  "legalKvkkB4": "Your data is shared only with the board of clubs you join and, when legally required, with authorised institutions.",
  "@legalKvkkB4": {
    "description": "Key legal.kvkk.b4"
  },
  "legalKvkkB5": "Membership data is kept at most 1 year after graduation or deletion; attendance records are anonymised at term end.",
  "@legalKvkkB5": {
    "description": "Key legal.kvkk.b5"
  },
  "legalKvkkB6": "Under Article 11 of KVKK you may access, correct, delete your data and object to processing.",
  "@legalKvkkB6": {
    "description": "Key legal.kvkk.b6"
  },
  "legalKvkkB7": "Submit requests through the in-app Help & support form or kvkk@gumushane.edu.tr.",
  "@legalKvkkB7": {
    "description": "Key legal.kvkk.b7"
  },
