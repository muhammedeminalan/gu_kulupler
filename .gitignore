#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# macOS
.DS_Store

# Gizli anahtarlar ve imzalama
.env
.env.*
key.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Firebase servis hesabı / admin anahtarları
serviceAccount*.json
*-firebase-adminsdk-*.json

# Swift Package Manager (SPM) üretilen klasörleri
.build/
.swiftpm/

# Claude Code yerel ayarları (CLAUDE.md commit'lenir)
.claude/settings.local.json

# Kod üretimi (D-08: üretilen dosyalar commit edilmez)
*.g.dart
*.gen.dart
lib/l10n/app_localizations*.dart

# Kalite kapısı önbelleği, kapsam raporları, paket araç/derleme dizinleri (CD-05)
tool/.cache/
**/coverage/
# Araç öz-testi fixture'ları (CD-79): sahte lcov raporları commit edilir
!tool/test/fixtures/**/coverage/
packages/*/.dart_tool/
packages/*/build/

# Konvansiyon örnekleri yalnızca yerelde tutulur; GitHub'a gitmez (kullanıcı kararı 2026-10-09). Klasör diskte kalır.
reference/

# Node bağımlılıkları (firebase/, tool/admin, tool/seed) — package-lock.json commit edilir (CD-40)
node_modules/
# Firebase emülatör yerel verisi ve günlükleri (yalnızca yerel; --import/--export-on-exit)
firebase/.emulator-data/
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
