rules_version = '2';

// GÜ Kulüpler — Firestore Security Rules.
// Sözleşme: docs/firestore-rules-spec.md · matris: docs/PLAN.md §11.1 · testler: firebase/test/rules/.
//
// T-10: VARSAYILAN RET iskeleti. Her koleksiyon ve alt koleksiyon için açık bir `match` bloğu vardır
// (adlar packages/gu_data/lib/src/constants/firestore_collections.dart ile birebir —
// firebase/test/rules/delete_denied.test.js karşılaştırır); bloklar sahibi task'ta açılır (blok
// başlıklarındaki T-xx). O güne kadar hiçbir istemci o bloğun belgelerini okuyamaz ve yazamaz.
// Açılan bloklar: T-12 → users (sahibi C/U), users/private/account (sahibi C/U), settings.
// T-15 → clubs (okuma + `memberCount` sayaç dalı), memberships (okuma + başvuran geçişleri M1–M4, M7, M8),
// memberships/private/contact (okuma + başvuranın C / yeniden başvuru notu), reports (C + okuma),
// blocks, activity (okuma + başvuranın / üyenin kendi geçiş günlüğü).
// T-19 → posts, posts/votes, comments, savedPosts, announcementCounters; clubs `pinnedPostId` dalı;
// activity gönderi yayını türleri (`post_created`, `announcement`, `poll`).
// T-22 → events (+ yan belge events/{id}/private/counter — W-64), rsvps; activity etkinlik türleri
// (`event_published`, `event_cancelled`).
// T-25 → notifications (sahibi R / U; tür bazlı C: application_received, announcement, event_new,
// event_cancelled, waitlist_promoted, event_reminder).
//
// Null olabilen alanlar `data.get('alan', null)` ile okunur (W-51, CD-130): istemci null alanı hiç
// yazmaz (anahtar yok), seed açık `null` yazar; doğrudan erişim eksik anahtarda hata verir (= ret).
//
// Değişmez kurallar (tool/check_no_hard_delete.js HD20–HD22, tool/check_rules_parity.js RP01–RP06):
//  - `allow delete: if false;` her blokta kalır — süper admin dahil (D-10). Silme = soft delete (update).
//  - `allow write` yazılmaz (delete'i de kapsar); create ve update ayrı ayrı açılır.
//  - 0 ve 1 dışındaki her sayısal literal ve her `duration.value(...)` satırı `// limit: <Limits adı>`
//    etiketi taşır; e-posta deseni EmailDomainPolicy.rulesRegex() ile aynıdır.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcı fonksiyonlar (docs/firestore-rules-spec.md §2) ─────────────────────────────────

    // ---- kimlik ----
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSuper() { return signedIn() && request.auth.token.get('superadmin', false) == true; }
    function emailOk() {
      return signedIn() && request.auth.token.email_verified == true
          // GEÇİCİ (test): gmail.com — W-61, teslimden önce kaldırılır
          && request.auth.token.email.lower().matches('.*@(ogr\\.gumushane\\.edu\\.tr|gumushane\\.edu\\.tr|gmail\\.com)');
    }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function me() { return get(userPath(uid())).data; }
    // aktif = e-posta doğrulanmış + kullanıcı belgesi var + askıda/silinmiş değil + profil tamam
    function activeUser() {
      return emailOk() && exists(userPath(uid())) && me().status == 'active' && me().profileComplete == true;
    }

    // ---- üyelik ----
    function mPath(c, u) { return /databases/$(database)/documents/memberships/$(c + '_' + u); }
    function hasM(c) { return exists(mPath(c, uid())); }
    function myM(c) { return get(mPath(c, uid())).data; }
    function mActive(c) { return hasM(c) && myM(c).status == 'active'; }
    function isMember(c) { return mActive(c) && myM(c).role in ['member', 'board', 'president']; }
    function isManager(c) { return mActive(c) && myM(c).role in ['board', 'president']; }
    function isPres(c) { return mActive(c) && myM(c).role == 'president'; }
    function isAdvisor(c) { return mActive(c) && myM(c).role == 'advisor'; }
    // Okuma kapıları — ikisi de doğrulanmış, izinli alan adlı e-posta ister (PLAN §11.1 `unver` sütunu):
    // üyelik belgesi `active` kalsa da doğrulamasını / alan adını yitiren jeton içeriği okuyamaz.
    // gönderi, üye listesi, members-only etkinlik. Askıdaki üye OKUR (üyeliği `active` kaldıysa — §11.1 satır 6).
    function seesInside(c) { return emailOk() && (isSuper() || mActive(c)); }
    // yönetim paneli (danışman salt okunur): başvurular, `private/contact`, günlük. Yönetici / danışmanın
    // hesabı AKTİF olmalıdır: askıya alınan yönetici (Mod C'de Auth hesabı açık kalır) geçerli jetonuyla
    // başvuranların e-postasını, notunu ve günlüğü okuyamaz (§11.1 satır 4, 5, 13 `susp`; CD-137 madde 8r).
    function seesMgmt(c) { return emailOk() && (isSuper() || (activeUser() && (isManager(c) || isAdvisor(c)))); }

    // ---- ortak alanlar (BaseFieldsPayload / SoftDelete ile aynı anahtarlar) ----
    function baseCreate() {
      return request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.isDeleted == false
          && request.resource.data.get('deletedAt', null) == null
          && request.resource.data.get('deletedBy', null) == null;
    }
    function touches(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys.concat(['updatedAt']))
          && request.resource.data.updatedAt == request.time;
    }
    function isSoftDelete(extra) {
      return resource.data.isDeleted == false && request.resource.data.isDeleted == true
          && request.resource.data.deletedBy == uid() && request.resource.data.deletedAt == request.time
          && touches(['isDeleted', 'deletedAt', 'deletedBy'].concat(extra));
    }
    function isRestore(extra) {
      return resource.data.isDeleted == true && request.resource.data.isDeleted == false
          && request.resource.data.deletedAt == null && request.resource.data.deletedBy == null
          && touches(['isDeleted', 'deletedAt', 'deletedBy'].concat(extra));
    }
    // delta doğrulama (±1) — `getAfter` aynı batch içindeki yazımı görür
    function counterDelta(path, field, d) { return getAfter(path).data[field] == get(path).data[field] + d; }

    // ---- sayaç–belge eşliği (PLAN §11.2b, CD-41) ----
    // İş belgesi dalı `counterDelta` ile sayacın, sayaç dalı iş belgesinin AYNI batch'te doğru geçişi yaptığını
    // görür. İş belgesinin yolu, aktör belgenin sahibiyken oturumdan TÜRETİLİR (`mPath(clubId, uid())`):
    // herkese açık sayaç belgesine yazılmaz (CD-137 madde 8q — `clubs.lastMembershipRef` kimin katıldığını /
    // ayrıldığını üye olmayana sızdırıyordu). Aktörün sahibi olmadığı dallar (yönetici — T-30; yorum /
    // katılım sayaçları — T-19 / T-22) iş belgesini bir işaretçiden okur; işaretçi yardımcıları (`refAfter` …)
    // ve işaretçinin duracağı belge o task'ta eklenir (herkese açık belgede kullanıcı kimliği taşıyan yol
    // DURMAZ). `exists` / `get` yazım-öncesi durumu verir (M2'de üyelik henüz yoktur).
    // T-22: etkinlik sayaçlarında kendi katılımının yolu oturumdan türetilir; yönetici dallarının (yoklama,
    // terfi) işaretçisi `events/{eventId}/private/counter` yan belgesindedir (yalnızca `seesMgmt` okur).
    function clubPath(c) { return /databases/$(database)/documents/clubs/$(c); }
    function delta(field) { return request.resource.data[field] - resource.data[field]; }

    // ---- içerik (T-19: gönderi, yorum, oy, kayıt, duyuru sayacı) ----
    function postPath(p) { return /databases/$(database)/documents/posts/$(p); }
    function commentPath(c) { return /databases/$(database)/documents/comments/$(c); }
    function counterPath(id) { return /databases/$(database)/documents/announcementCounters/$(id); }
    // Gizlenmiş (`isHidden`) ya da silinmiş gönderi / yorumu okuma ayrıcalığı: süper admin; hesabı AKTİF yazar
    // ve kulüp yöneticisi. Sıradan üye, danışman ve askıdaki hesap kaldırılmış içeriği okuyamaz.
    function seesRemoved(c, author) { return isSuper() || (activeUser() && (author == uid() || isManager(c))); }
    // Gizle / göster (yalnızca süper admin çağırır): `false → true` gizleyeni ve sunucu zamanını yazar;
    // `true → false` ikisini `null`'a çeker. Sayaç, sabitleme ve silme alanları beyaz listede yoktur.
    function isHideToggle() {
      let d = request.resource.data;
      return touches(['isHidden', 'hiddenBy', 'hiddenAt'])
          && ((resource.data.isHidden == false && d.isHidden == true
               && d.hiddenBy == uid() && d.hiddenAt == request.time)
              || (resource.data.isHidden == true && d.isHidden == false
                  && d.get('hiddenBy', null) == null && d.get('hiddenAt', null) == null));
    }
    // Rules'ta döngü yoktur: liste baştan birer eleman soyularak denetlenir (ilk eleman + kuyruk).
    function tail(l) { return l.size() <= 1 ? [] : l[1:l.size()]; }
    // Istanbul günü (CD-129): sunucu saati + 3 sa; gün eşitliği TOLERANSSIZDIR (komşu gün anahtarı ret —
    // istemci gün sınırı penceresinde bir kez komşu günle yeniden dener, W-50). `yyyyMMdd` = sayaç belge
    // kimliğinin eki (FirestoreIds.announcementCounter), `yyyy-MM-dd` = `day` alanı (AppClock.istanbulDay).
    function pad2(n) { return string(n).size() == 1 ? '0' + string(n) : string(n); }
    function istanbulNow() { return request.time + duration.value(3, 'h'); }   // limit: istanbulUtcOffset
    function istanbulDayKey() {
      let t = istanbulNow();
      return string(t.year()) + pad2(t.month()) + pad2(t.day());
    }
    function istanbulDay() {
      let t = istanbulNow();
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    // Yayın / katılım kabul eden kulüp: silinmemiş ve askıda değil (gönderi yayını ve düzenlemesi — T-19;
    // etkinlik yazımları ve katılım — T-22). 1 erişim yolu: kulüp.
    function clubLive(c) {
      let club = get(clubPath(c)).data;
      return club.isDeleted == false && club.status == 'active';
    }

    // ---- etkinlik ve katılım (T-22) ----
    function eventPath(e) { return /databases/$(database)/documents/events/$(e); }
    function rsvpDoc(id) { return /databases/$(database)/documents/rsvps/$(id); }
    // Katılım kaydının kimliği FirestoreIds.rsvp kalıbıdır (`{eventId}_{userId}`). Birleşim tek başına
    // belirsizdir (`a_b` + `c` = `a` + `b_c`): bu yolu okuyan her kural belgenin `eventId` / `userId`
    // alanlarını da karşılaştırır (T-21 dersi).
    function rsvpPath(e, u) { return rsvpDoc(e + '_' + u); }
    // Yönetici sayaç işaretçisinin yan belgesi (W-64): yalnızca `seesMgmt` okur.
    function eventCounterPath(e) { return /databases/$(database)/documents/events/$(e)/private/counter; }
    // Etkinliğin üç sayacı İŞLEMİN TAMAMINDA tam bu kadar oynar (`get` = işlem öncesi, `getAfter` = sonrası):
    // katılım kuralı sayaçsız, çift sayaçlı ya da ters yönlü işlemi değerlendirme sırasından bağımsız
    // reddeder (CD-141 madde 11 dersi). 1 erişim yolu: etkinlik.
    function eventCountersMoved(e, going, waitlist, attended) {
      let was = get(eventPath(e)).data;
      let now = getAfter(eventPath(e)).data;
      return now.goingCount == was.goingCount + going
          && now.waitlistCount == was.waitlistCount + waitlist
          && now.attendedCount == was.attendedCount + attended;
    }

    // ── Koleksiyonlar (PLAN §11.1 — 18 satır) ───────────────────────────────────────────────────

    // 1 · users/{uid} — T-12 (askı T-37, hesap silme T-29) · rules-spec §3.1
    // Yazma yolları: UserRepository.createProfile (C; 1 erişim çağrısı: existsAfter private/account) ·
    // updateProfile (U, sahibi; erişim çağrısı yok).
    // Kapalı kalan dallar: süper admin `status: active↔suspended` (T-37), sahibinin `deleted` dalı (T-29).
    // `suspendReason` bu belgenin alanı DEĞİLDİR (CD-133): hiçbir beyaz listede yoktur.
    match /users/{uid} {
      // sahibi: kendi belgesi + doğrulanmış, izinli alan adlı e-posta. `uid` = yol değişkeni
      // (`match /users/{uid}`); oturum kimliği `uid()` yardımcısıyla karışmasın diye açık yazılır.
      function isOwner() { return emailOk() && request.auth.uid == uid; }

      // Sonuç belgenin (create: yeni belge · update: birleşmiş belge) alan tipleri ve sınırları.
      // Belge her doğrulanmış kullanıcıya açıktır: tip hatası başkalarının listesini bozmasın diye
      // beyaz listedeki her alanın tipi burada sabitlenir (UserModel.fromJson `checked: true`).
      function userShape() {
        let d = request.resource.data;
        // alt sınır kırpılmış metinde aranır: yalnızca boşluktan oluşan ad listelerde "adsız" görünür
        return d.name is string && d.name.trim().size() >= 2 && d.name.size() <= 60   // limit: nameMin, nameMax
            // CD-11: `nameLower == name.lower()` eşitliği YOK (Türkçe küçük harf Rules'ta üretilemez)
            && d.nameLower is string && d.nameLower.trim().size() >= 2 && d.nameLower.size() <= 60   // limit: nameMin, nameMax
            // belge herkese açıktır: üst sınır yoksa tek kullanıcı her listeye ~1 MB yük bindirebilir
            && d.avatarSeed is string && d.avatarSeed.size() > 0 && d.avatarSeed.size() <= 64   // limit: avatarSeedMax
            // StoragePaths.isUserAvatar: yalnızca kendi klasörü + StoragePaths.fileNamePattern
            // (users/{uid}/<yyyyMMddTHHmmssZ>_<16 hex>.<jpg|png|webp>; parity.test.js karşılaştırır)
            && (d.get('avatarPath', null) == null
                || (d.avatarPath is string
                    && d.avatarPath.matches('users/' + uid + '/\\d{8}T\\d{6}Z_[0-9a-f]{16}\\.(?:jpg|png|webp)')))
            // StaticTables.departmentIds (d01–d24) biçimi
            && (d.get('department', null) == null
                || (d.department is string && d.department.matches('d[0-9][0-9]')))
            // YearLevel değerleri
            && (d.get('year', null) == null
                || d.year in ['prep', '1', '2', '3', '4', '5plus', 'master', 'phd'])
            // StaticTables.interestIds (i01–i16); alt sınır (≥ 1) yalnızca güncellemede (aşağıda)
            && d.interests is list && d.interests.size() <= 5   // limit: interestsMax
            && d.interests.hasOnly(['i01', 'i02', 'i03', 'i04', 'i05', 'i06', 'i07', 'i08',
                                    'i09', 'i10', 'i11', 'i12', 'i13', 'i14', 'i15', 'i16'])
            && d.bio is string && d.bio.size() <= 140   // limit: bioMax
            && d.profileComplete is bool;
      }

      // C — kayıt sonrası ilk belge (AUT-03 → AUT-05 öncesi). `activeUser()` istenemez: belge henüz yok.
      // Profil, hesap belgesi OLMADAN oluşturulamaz (`existsAfter`: aynı batch'teki yazımı görür —
      // createProfile). Aksi halde hesap belgesiz "aktif" kullanıcı askıya alınamaz (T-37 batch'i
      // `private/account`'u günceller; süper admin için C yoktur) ve ADM-05 e-posta aramasında görünmez.
      function canCreateUser() {
        let d = request.resource.data;
        return isOwner()
            && d.keys().hasOnly(['name', 'nameLower', 'avatarSeed', 'avatarPath', 'department', 'year',
                                 'interests', 'bio', 'status', 'staff', 'profileComplete',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.status == 'active' && d.staff == false && d.profileComplete == false
            && userShape()
            && existsAfter(/databases/$(database)/documents/users/$(uid)/private/account);
      }

      // U (sahibi) — profil alanları. `status`, `staff`, `createdAt`, `isDeleted*` beyaz listede yoktur
      // → değişemez. Askıdaki / silinmiş kullanıcı profilini düzenleyemez (PLAN §11.1 satır 1 susp/del).
      function canUpdateOwnProfile() {
        return isOwner()
            && resource.data.status == 'active'
            && touches(['name', 'nameLower', 'avatarSeed', 'avatarPath', 'department', 'year',
                        'interests', 'bio', 'profileComplete'])
            && userShape()
            // personelde (staff) ilgi alanı boş kalabilir; öğrencide en az bir tane
            && (resource.data.staff == true || request.resource.data.interests.size() >= 1)   // limit: interestsMin
            // AUT-05 zorunlu alanları: profil ancak bölüm (öğrencide ayrıca sınıf) doluyken "tamam" olur
            // — `activeUser()` bu bayrağa bakar; değiştirilmiş istemci adımı atlayamaz
            && (request.resource.data.profileComplete == false
                || (request.resource.data.get('department', null) != null
                    && (resource.data.staff == true || request.resource.data.get('year', null) != null)))
            // tamamlanan profil geri alınamaz (true → false yok)
            && (resource.data.profileComplete == false || request.resource.data.profileComplete == true);
      }

      // R — doğrulanmış her kullanıcı (rules-spec §9.1 kabul edilmiş sınırlama). `isDeleted` süzgeci
      // YOKTUR: anonimleştirilmiş yazar "Silinmiş kullanıcı" olarak okunur (getUser / getUsers);
      // liste ekranları (ADM-05) `isDeleted == false` süzgecini sorguda taşır.
      allow read: if emailOk();
      allow create: if canCreateUser();
      allow update: if canUpdateOwnProfile();
      allow delete: if false;

      // 2 · users/{uid}/private/account — T-12 (süper admin `suspendReason` yazımı T-37) · rules-spec §3.2
      // Yazma yolları: UserRepository.createProfile (C; 1 erişim çağrısı: existsAfter users/{uid}) ·
      // touchLastLogin (U; erişim çağrısı yok).
      // `suspendReason` sahibi için SALT OKUNURDUR (CD-133): C'de yok / null, U'da değişemez.
      // Kapalı kalan dallar: süper admin U (T-37), anonimleştirme (T-29), collectionGroup('private') (T-37).
      match /private/{docId} {
        // `fcmTokens[i]` = FcmTokenModel {token, platform, updatedAt} (üçü de zorunlu). Belgeyi süper
        // admin de okur (ADM-05): tek bozuk eleman onun okumasını ve e-posta araması sayfasını
        // ayrıştırma hatasına düşürür → eleman biçimi burada sabitlenir.
        function fcmTokenOk(t) {
          return t is map && t.keys().hasOnly(['token', 'platform', 'updatedAt'])
              && t.token is string && t.token.size() > 0 && t.token.size() <= 4096   // limit: fcmTokenMax
              && t.platform in ['ios', 'android']
              && t.updatedAt is timestamp;
        }
        // Rules'ta döngü yoktur: liste baştan birer eleman soyularak denetlenir (ilk eleman + kuyruk).
        function fcmHeadOk(l) { return l.size() == 0 || fcmTokenOk(l[0]); }
        function fcmTail(l) { return l.size() <= 1 ? [] : l[1:l.size()]; }
        function fcmTokensOk(l) {
          let t1 = fcmTail(l);
          let t2 = fcmTail(t1);
          let t3 = fcmTail(t2);
          let t4 = fcmTail(t3);
          let t5 = fcmTail(t4);
          let t6 = fcmTail(t5);
          let t7 = fcmTail(t6);
          let t8 = fcmTail(t7);
          let t9 = fcmTail(t8);
          return l is list && l.size() <= 10   // limit: fcmTokensMax
              && fcmHeadOk(l) && fcmHeadOk(t1) && fcmHeadOk(t2) && fcmHeadOk(t3) && fcmHeadOk(t4)
              && fcmHeadOk(t5) && fcmHeadOk(t6) && fcmHeadOk(t7) && fcmHeadOk(t8) && fcmHeadOk(t9);
        }

        // Sonuç belge: e-posta token'daki adresle aynıdır; `fcmTokens` üst sınırlı ve biçimlidir.
        function accountShape() {
          let d = request.resource.data;
          return d.email == request.auth.token.email
              && d.emailLower == request.auth.token.email.lower()
              && fcmTokensOk(d.fcmTokens);
        }

        // Hesap belgesi, profil belgesi OLMADAN oluşturulamaz (`existsAfter`; bkz. canCreateUser).
        function canCreateAccount() {
          let d = request.resource.data;
          return isOwner() && docId == 'account'
              && d.keys().hasOnly(['email', 'emailLower', 'fcmTokens', 'lastLoginAt', 'suspendReason',
                                   'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
              && baseCreate()
              && d.get('suspendReason', null) == null
              && (d.get('lastLoginAt', null) == null || d.lastLoginAt == request.time)
              && accountShape()
              && existsAfter(userPath(uid));
        }

        // U (sahibi) — `suspendReason`, `createdAt`, `isDeleted*` beyaz listede yoktur → değişemez.
        // Askıdaki kullanıcı da yazabilir (emailOk yeter; PLAN §11.1 satır 2 susp/del).
        function canUpdateOwnAccount() {
          return isOwner() && docId == 'account'
              && touches(['email', 'emailLower', 'fcmTokens', 'lastLoginAt'])
              && accountShape()
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastLoginAt'])
                  || request.resource.data.lastLoginAt == request.time);
        }

        // R — yalnızca sahibi (kendi e-postası ve askı gerekçesi) ve süper admin (ADM-05).
        allow get: if isOwner() || isSuper();
        allow list: if false;
        allow create: if canCreateAccount();
        allow update: if canUpdateOwnAccount();
        allow delete: if false;
      }
    }

    // 3 · clubs/{clubId} — T-15 (okuma + sayaç dalı) · T-30 (yönetim, devir) · T-37 (süper admin) · rules-spec §3.3
    // Okuma yolları: ClubRepository.fetchActiveClubs (L: `isDeleted == false`) · getClub (G) · getClubs
    // (L: `documentId in […]` + `isDeleted == false`) · üyelik işlemlerinin kulüp okuması (G).
    // Yazma yolu (T-15): yalnızca sayaç dalı — MembershipRepository.joinInstant (+1) / leave (−1).
    // Yazma yolu (T-19): `pinnedPostId` dalı — PostRepository.pin / unpin / softDeletePost (sabit gönderi).
    // Kapalı kalan dallar: C (süper admin, ADM-03 — T-37) · U yönetim alanları ve `presidentId` devri (T-30) ·
    // U süper admin `status` / `suspendReason` / ad alanları (T-37) · sayaç dalının yönetici ve süper admin
    // aktörü (M5 / M9 / M12 — T-30; M9 süper — T-37) ve hesap silme (M14 — T-29).
    match /clubs/{clubId} {
      // U (sayaç dalı, PLAN §11.2b) — yalnızca `memberCount` ±1 (+ `updatedAt`).
      // T-15 aktörü yalnızca üyeliğin sahibidir: eşlik eden belge oturumun BU kulüpteki üyeliğidir
      // (`memberships/{clubId}_{uid}`); geçiş o belgenin yazım-öncesi ve yazım-sonrası durumundan doğrulanır
      // (tek başına sayaç yazan batch reddedilir): +1 = katılım (M2 / M3 `active`), −1 = ayrılma (M8).
      // Kulüp belgesi doğrulanmış herkese açıktır: üyeliğin yolu (`lastMembershipRef`) bu belgeye YAZILMAZ —
      // beyaz listede yoktur (CD-137 madde 8q). Yönetici / süper admin aktörü T-30 / T-37'de eklenir.
      // 1 erişim yolu: üyelik belgesi (getAfter + get / exists).
      function canBumpMemberCount() {
        let ref = mPath(clubId, uid());
        let m = getAfter(ref).data;
        let d = delta('memberCount');
        return touches(['memberCount'])
            && d in [-1, 1]
            && request.resource.data.memberCount >= 0
            && m.clubId == clubId && m.userId == uid()
            && ((d == 1 && m.status == 'active' && (!exists(ref) || get(ref).data.status != 'active'))
                || (d == -1 && m.status == 'left' && get(ref).data.status == 'active'));
      }

      // U (`pinnedPostId` dalı, T-19) — yalnızca `pinnedPostId` (+ `updatedAt`), gönderi yazımıyla AYNI işlemde.
      // İki yönlü bağ: bu dal yeni sabit gönderinin yazım-sonrası `pinned == true` (bu kulübün, silinmemiş)
      // ve eski sabit gönderinin `pinned == false` olduğunu görür; gönderi dalı (`canTogglePin`) da kulübün
      // yazım-sonrası `pinnedPostId` değerine bakar. Tek başına `pinnedPostId` yazan ya da başka kulübün
      // gönderisini gösteren işlem reddedilir; aynı anda iki gönderi sabit kalamaz.
      // Değer `null`'a çekilirken aktör yönetici olmayabilir: eski sabit gönderi BU işlemde siliniyorsa
      // (süper adminin moderasyon silmesi — gönderi kuralı yetkilendirir) dal ona da açıktır.
      // Değer rastgele gönderi kimliğidir (kullanıcı kimliği taşımaz); üye olmayan o gönderiyi okuyamaz.
      // En çok 4 erişim yolu: users/{uid} · üyelik · yeni gönderi · eski gönderi.
      function pinnedNow(p) { return p.clubId == clubId && p.pinned == true && p.isDeleted == false; }
      function removedNow(p) { return get(postPath(p)).data.isDeleted == false && getAfter(postPath(p)).data.isDeleted == true; }
      function canSetPin() {
        let now = request.resource.data.get('pinnedPostId', null);
        let was = resource.data.get('pinnedPostId', null);
        return touches(['pinnedPostId'])
            && now != was
            && (was == null || !existsAfter(postPath(was)) || getAfter(postPath(was)).data.pinned == false)
            && (now != null
                ? (now is string && now.matches('[A-Za-z0-9_-]+') && pinnedNow(getAfter(postPath(now)).data)
                   && activeUser() && isManager(clubId))
                : ((activeUser() && isManager(clubId)) || removedNow(was)));
      }

      // R — doğrulanmış her kullanıcı; silinmiş kulübü yalnızca süper admin okur. Askıdaki kulüp okunur
      // (kart "askıda" görünümü; listeden ayıklamak arayüzdedir — rules-spec §9.5). Liste sorgusu
      // `isDeleted == false` süzgecini taşımak zorundadır (rules-spec §6). Olmayan kulübün tekil okuması
      // boş döner (`resource == null`): "yok" ile "yetkisiz" ayrışır. Kimlik listeli sorgu
      // (`documentId in […]` — getClubs) belge belge değerlendirilir: listedeki silinmiş ya da olmayan TEK
      // kimlik sorgunun tamamını düşürür (süper admin hariç; listede `resource == null` okunamaz).
      allow get: if emailOk() && (resource == null || resource.data.isDeleted == false || isSuper());
      allow list: if emailOk() && (resource.data.isDeleted == false || isSuper());
      allow create: if false;
      allow update: if canBumpMemberCount() || canSetPin();
      allow delete: if false;
    }

    // 4 · memberships/{clubId}_{userId} — T-15 (M1–M4, M7, M8) · T-30 (M5–M12) · T-37 (M13) · T-29 (M14)
    // rules-spec §3.4 · durum makinesi domain-model §5 · PLAN §11.2.
    // Yazma yolları (T-15, hepsi belgenin sahibi): MembershipRepository.apply (M1 C / M3–M4 U) ·
    // joinInstant (M2 C / M3 U) · cancelApplication (M7) · leave (M8).
    // Kapalı kalan dallar: M5 onay · M6 red (`retryAfter` = +7 gün, ±5 dk) · M9 çıkarma · M10 rol ·
    // M11 devir · M12 geri al (T-30) · M13 danışman (T-37) · M14 hesap silme (T-29). Yönetici, danışman ve
    // süper admin bu belgeyi T-30 / T-37'ye kadar YAZAMAZ.
    // Belge e-posta ve başvuru notu TAŞIMAZ (D-29, CD-137): `note` hiçbir beyaz listede yoktur.
    // Dal sırası: her dal önce ucuz ayırıcıya (önceki / sonraki `status`) bakar, erişim çağrıları sonra
    // gelir — eşleşmeyen dallar kısa devre olur (istek başına 1000 ifade sınırı; T-30 dalları da böyle eklenir).
    match /memberships/{membershipId} {
      function contactPath() {
        return /databases/$(database)/documents/memberships/$(membershipId)/private/contact;
      }

      // Belge kimliği oturumun uid'iyle mi bitiyor (`…_<uid>`)? Yalnızca OLMAYAN belgenin tekil
      // okumasında kullanılır (var olan belgede sahiplik `userId` alanından okunur).
      function ownMembershipId() {
        let suffix = '_' + uid();
        return membershipId.size() > suffix.size()
            && membershipId[membershipId.size() - suffix.size():membershipId.size()] == suffix;
      }

      // R (rules-spec §3.4): (a) sahibi · (b) kulüp yönetimi, danışman, süper admin · (c) üye listesi:
      // kulübün aktif üyesi yalnızca `active` belgeleri okur (`pending` / `rejected` / `removed` / `left` /
      // `cancelled` belgeleri (c)'ye girmez).
      // (b) ve (c) de `emailOk()` ister; (b) ayrıca aktif hesap (`seesMgmt`): askıdaki yönetici başvuruları
      // listeleyemez. Askıdaki sıradan üye üye listesini okur (`seesInside`), kendi belgesini de ((a)).
      // (d) yönetici görünürlüğü (T-17, CD-139): kulübün ETKİN yöneticileri — başkan, yönetim kurulu,
      // danışman — doğrulanmış ve AKTİF her kullanıcıya okunur (CLB-03 "Yönetim kurulu", kulüp kartı avatar
      // grubu). Sıradan üyeler ve `pending` / `rejected` / `removed` / `left` / `cancelled` belgeleri (d)'ye
      // girmez: tam üye listesi üyelere özel kalır ((c)); `private/contact` bu daldan ETKİLENMEZ (kapalı).
      function isVisibleManager() {
        return resource.data.status == 'active' && resource.data.role in ['president', 'board', 'advisor'];
      }
      function canReadMembership() {
        return (emailOk() && resource.data.userId == uid())
            || seesMgmt(resource.data.clubId)
            || (resource.data.status == 'active' && seesInside(resource.data.clubId))
            || (isVisibleManager() && activeUser());
      }

      // Karar alanları boş mu (anahtar yok ya da açık null — W-51)?
      function decisionCleared(d) {
        return d.get('decidedAt', null) == null && d.get('decidedBy', null) == null
            && d.get('retryAfter', null) == null && d.get('rejectReason', null) == null
            && d.get('rejectNote', null) == null;
      }

      // `applicant` = başvuranın `users/{uid}` belgesinden anlık görüntüsü (ad, bölüm, sınıf, avatar tohumu).
      // Belgeyi kulübün her aktif üyesi okur: dört alan kullanıcı belgesiyle birebir olmalıdır (biçimi
      // users kuralları sabitler); başka anahtar (e-posta, not) taşıyamaz.
      function applicantOk(a) {
        let u = me();
        return a is map && a.keys().hasOnly(['name', 'department', 'year', 'avatarSeed'])
            && a.name == u.name && a.avatarSeed == u.avatarSeed
            && a.get('department', null) == u.get('department', null)
            && a.get('year', null) == u.get('year', null);
      }

      // Başvuru / katılım kabul eden kulüp: silinmemiş, askıda değil, başvurular açık.
      function clubOpen(club) {
        return club.isDeleted == false && club.status == 'active' && club.applicationsOpen == true;
      }

      // `requireNote` kulübünde not, aynı batch'te yazılan `private/contact.note`'tan okunur (CD-137).
      // Kırpılmış metin ölçülür: yalnızca boşluktan oluşan not "verilmiş" sayılmaz (istemci
      // `FieldValidators.applicationNote` ile aynı; CD-138 madde 3).
      function noteGiven(club, contact) { return club.requireNote == false || contact.note.trim().size() > 0; }

      // C ortak biçimi (M1 / M2): yeni belge, sahibi oturumdur, kimlik `clubId_userId` ile birebirdir.
      // Süper admin başvuramaz / katılamaz (domain-model §3 `apply`: yalnızca öğrenci; RolePolicy ile aynı).
      function isNewOwnMembership() {
        let d = request.resource.data;
        return d.keys().hasOnly(['clubId', 'userId', 'status', 'role', 'applicant', 'appliedAt', 'decidedAt',
                                 'decidedBy', 'retryAfter', 'rejectReason', 'rejectNote', 'priorCount',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && !isSuper()
            && d.userId == uid()
            && d.clubId is string
            && membershipId == d.clubId + '_' + d.userId
            && d.role == 'member' && d.priorCount == 0 && d.appliedAt == request.time
            && decisionCleared(d) && applicantOk(d.applicant);
      }

      // M1 — create `pending` (Başvur). `private/contact` aynı batch'te oluşur (e-posta token'dan).
      // 3 erişim yolu: users/{uid} · clubs/{c} · private/contact (getAfter).
      function canApply() {
        let d = request.resource.data;
        let club = get(clubPath(d.clubId)).data;
        let contact = getAfter(contactPath()).data;
        return d.status == 'pending' && activeUser() && isNewOwnMembership()
            && clubOpen(club) && club.approvalRequired == true
            && contact.email == request.auth.token.email
            && noteGiven(club, contact);
      }

      // M2 — create `active` (anında katıl): onaysız kulüp + `memberCount +1` aynı batch'te.
      function canJoinInstant() {
        let d = request.resource.data;
        let club = get(clubPath(d.clubId)).data;
        return d.status == 'active' && activeUser() && isNewOwnMembership()
            && clubOpen(club) && club.approvalRequired == false
            && getAfter(contactPath()).data.email == request.auth.token.email
            && counterDelta(clubPath(d.clubId), 'memberCount', 1);
      }

      // U ortak biçimi (M3 / M4 — yeniden başvuru / katılım): karar alanları temizlenir, `priorCount +1`,
      // anlık görüntü yenilenir, rol `member`'a döner. `clubId`, `userId`, `createdAt`, `isDeleted*`
      // beyaz listede yoktur → değişemez. `private/contact` aynı batch'te yeniden yazılır
      // (`updatedAt == request.time`): eski başvurunun notu yeni başvuruya taşınmaz (CD-137).
      function isReapply() {
        let d = request.resource.data;
        return resource.data.userId == uid() && !isSuper() && activeUser()
            && touches(['status', 'role', 'applicant', 'appliedAt', 'priorCount', 'retryAfter', 'rejectReason',
                        'rejectNote', 'decidedAt', 'decidedBy'])
            && d.role == 'member' && d.appliedAt == request.time
            && d.priorCount == resource.data.get('priorCount', 0) + 1
            && decisionCleared(d) && applicantOk(d.applicant)
            && getAfter(contactPath()).data.updatedAt == request.time;
      }

      // M3 — `left` → `pending` (onaylı kulüp, M1 koşulları) | `active` (onaysız kulüp, M2 koşulları +
      // `memberCount +1`); `cancelled` → yalnızca `pending`, HER kulüpte. İptal edilen başvuru M4'ten gelmiş
      // olabilir (çıkarılan / reddedilen → `pending` → M7 `cancelled`): `cancelled → active` açık olsaydı
      // yönetici onayı "başvur → iptal → anında katıl" zinciriyle dolanılırdı (CD-137 madde 8s). Onaysız
      // kulüpte iptal edilmiş başvurunun sahibi yeniden başvurur ve yönetici onayını bekler.
      function canReapplyFromInactive() {
        let d = request.resource.data;
        let was = resource.data.status;
        let club = get(clubPath(resource.data.clubId)).data;
        return was in ['left', 'cancelled'] && isReapply() && clubOpen(club)
            && ((d.status == 'pending' && (club.approvalRequired == true || was == 'cancelled')
                 && noteGiven(club, getAfter(contactPath()).data))
                || (d.status == 'active' && was == 'left' && club.approvalRequired == false
                    && counterDelta(clubPath(resource.data.clubId), 'memberCount', 1)));
      }

      // M4 — `rejected` / `removed` → yalnızca `pending` (onaysız kulüpte de: reddedilen / çıkarılan kullanıcı
      // yöneticinin onayına döner), bekleme süresi dolduktan sonra. `retryAfter`'ı yönetici yazar (M6 / M9,
      // T-30: sunucu zamanı + 7 gün); burada sunucu saatiyle karşılaştırılır. Alan yoksa (W-51) bekleme yoktur.
      function canReapplyAfterCooldown() {
        let club = get(clubPath(resource.data.clubId)).data;
        return resource.data.status in ['rejected', 'removed'] && isReapply()
            && request.resource.data.status == 'pending'
            && (resource.data.get('retryAfter', null) == null || request.time >= resource.data.retryAfter)
            && clubOpen(club) && noteGiven(club, getAfter(contactPath()).data);
      }

      // M7 — `pending` → `cancelled` (İsteği iptal): yalnızca `status`. Not düzenleme bu belgede değildir
      // (`private/contact` U(b), T-16).
      function canCancelApplication() {
        return resource.data.status == 'pending' && request.resource.data.status == 'cancelled'
            && resource.data.userId == uid() && activeUser()
            && touches(['status']);
      }

      // M8 — `active` → `left` (Ayrıl): yalnızca `status` + `memberCount −1` aynı batch'te. Başkan (önce
      // devir, M11) ve danışman (`memberCount` dışı; yalnızca M13) ayrılamaz.
      function canLeave() {
        return resource.data.status == 'active' && request.resource.data.status == 'left'
            && resource.data.userId == uid() && resource.data.role in ['member', 'board']
            && activeUser()
            && touches(['status'])
            && counterDelta(clubPath(resource.data.clubId), 'memberCount', -1);
      }

      // Olmayan kendi belgesinin tekil okuması boş döner (getMembership → null; başvuru işleminin ilk
      // okuması): `resource == null` yalnızca `…_<uid>` kimliğinde izinlidir (başkasının üyeliği var mı
      // sorusu yanıtlanmaz).
      allow get: if (resource == null && emailOk() && ownMembershipId()) || canReadMembership();
      // Sorgu sözleşmesi (rules-spec §6): `userId == uid` · `clubId` + `status == 'active'` (üye) ·
      // `clubId` (yönetim) · `status == 'active'` + `role in ['board', 'president'(, 'advisor')]` (herkes —
      // (d), `listManagers`). Süzgeçsiz sorgu yalnızca süper admine açıktır.
      allow list: if canReadMembership();
      allow create: if canApply() || canJoinInstant();
      allow update: if canReapplyFromInactive() || canReapplyAfterCooldown() || canCancelApplication() || canLeave();
      allow delete: if false;

      // 5 · memberships/{id}/private/contact — T-15 (not düzenleme T-16, anonimleştirme T-29) · rules-spec §3.4
      // Alanlar: `email`, `emailLower`, `note` (başvuru notu — CD-137) + BaseFields. "Sahibi" = üst üyelik
      // belgesinin `userId`'si. Yazma yolları (T-15): apply / joinInstant — M1 / M2'de C, M3 / M4'te U(a)
      // (belge yoksa C); T-16: updateApplicationNote — U(b) (bekleyen başvurunun notu). Yönetici, danışman
      // ve süper admin YAZAMAZ.
      // Kapalı kalan dallar: anonimleştirme (T-29) · collectionGroup('private') (T-37).
      match /private/{docId} {
        function membershipPath() { return /databases/$(database)/documents/memberships/$(membershipId); }

        // R — sahibi, kulüp yönetimi / danışmanı (`seesMgmt`: doğrulanmış e-posta + AKTİF hesap) ve süper
        // admin. Sıradan aktif üye, başka kulübün yöneticisi, askıdaki yönetici ve üye olmayanlar OKUYAMAZ:
        // e-posta ve başvuru notu üye listesine sızmaz.
        // Üst belge de bu belge de yokken sahibinin (`…_<uid>`) okuması boş döner (başvuru işlemi).
        function canReadContact() {
          return docId == 'contact'
              && ((emailOk() && (exists(membershipPath())
                                 ? get(membershipPath()).data.userId == uid()
                                 : (resource == null && ownMembershipId())))
                  || (exists(membershipPath()) && seesMgmt(get(membershipPath()).data.clubId)));
        }

        // C — yalnızca üyelik yazımıyla AYNI batch'te (yazım-sonrası üyelik: sahibi, `pending` | `active`,
        // `updatedAt == request.time`); e-posta token'daki adrestir. 1 erişim yolu: üyelik (getAfter).
        function canCreateContact() {
          let d = request.resource.data;
          let m = getAfter(membershipPath()).data;
          return emailOk() && docId == 'contact'
              && d.keys().hasOnly(['email', 'emailLower', 'note',
                                   'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
              && baseCreate()
              && d.email == request.auth.token.email
              && d.emailLower == request.auth.token.email.lower()
              && d.note is string && d.note.size() <= 300   // limit: applicationNoteMax
              && m.userId == uid() && m.status in ['pending', 'active'] && m.updatedAt == request.time;
        }

        // U(a) — yeniden başvuru notu: yalnızca `note` (+ `updatedAt`), M3 / M4 ile AYNI batch'te (üyelik
        // önce `left` / `cancelled` / `rejected` / `removed`, sonra `pending` | `active`). `email` /
        // `emailLower` değişmez. 2 erişim yolu: users/{uid} · üyelik (get + getAfter).
        function canRewriteNote() {
          return activeUser() && docId == 'contact'
              && get(membershipPath()).data.userId == uid()
              && get(membershipPath()).data.status in ['left', 'cancelled', 'rejected', 'removed']
              && getAfter(membershipPath()).data.status in ['pending', 'active']
              && touches(['note'])
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 300;   // limit: applicationNoteMax
        }

        // U(b) — not düzenleme (T-16; CLB-05 → MembershipRepository.updateApplicationNote): bekleyen
        // başvurunun sahibi notunu değiştirir. Yalnızca `note` (+ `updatedAt`); üyelik belgesi YAZILMAZ —
        // önce de sonra da `pending`'dir (onaylanmış / reddedilmiş / iptal edilmiş başvurunun notu değişmez;
        // U(a)'dan ayrışır: orada önceki durum `pending` değildir). Not isteyen kulüpte not boşaltılamaz
        // (M1 / M3 / M4'teki `noteGiven` koşulunun aynısı). `email` / `emailLower` değişmez.
        // 3 erişim yolu: users/{uid} · üyelik (get + getAfter) · kulüp.
        function canEditNote() {
          let m = get(membershipPath()).data;
          return activeUser() && docId == 'contact'
              && m.userId == uid() && m.status == 'pending'
              && getAfter(membershipPath()).data.status == 'pending'
              && touches(['note'])
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 300   // limit: applicationNoteMax
              && noteGiven(get(clubPath(m.clubId)).data, request.resource.data);
        }

        allow get: if canReadContact();
        allow list: if false;
        allow create: if canCreateContact();
        allow update: if canRewriteNote() || canEditNote();
        allow delete: if false;
      }
    }

    // 6 · posts/{postId} — T-19 (yayın bildirimi ve içerik yönetimi kompozisyonu T-30, şikayet çözümü T-37)
    // rules-spec §3.5 · sözleşme docs/plans/T-19.md §6.
    // Yazma yolları: PostRepository.create (C; gönderi + günlük, bildirimli duyuruda + duyuru sayacı) ·
    // update (U düzenleme) · like / unlike (U beğeni) · pin / unpin (U + `clubs.pinnedPostId`) ·
    // softDeletePost / restorePost · hide / unhide (süper admin) · CommentRepository.add /
    // softDeleteComment / restoreComment (U sayaç dalı: `commentCount ±1` + `lastCommentRef`).
    // Beğeni ayrı belge DEĞİLDİR (`likes` dizisi); oy sayacı alanı YOKTUR (sayım `votes` üzerinde `count()`).
    // Null olabilen alanlar (W-51): `title`, `poll`, `lastCommentRef`, `hiddenBy`, `hiddenAt`, `editedAt`.
    // Dal sırası: her dal önce ucuz ayırıcıya (beyaz liste, önceki / sonraki değer) bakar; erişim çağrıları
    // sonra gelir. En ağır işlem (bildirimli duyuru yayını): 5 ayrı yol (users · üyelik · kulüp · sayaç · gönderi).
    match /posts/{postId} {
      // R — kulübün içini gören (`seesInside`: aktif üyelik ya da süper admin; askıdaki üye okur). Gizli /
      // silinmiş gönderiyi yalnızca `seesRemoved` okur. Liste sorgusu `clubId` + `isDeleted == false`
      // (+ üye için `isHidden == false`) süzgeçlerini taşımak zorundadır (rules-spec §6 FED-01 / MGT-08).
      // Olmayan gönderinin tekil okuması reddedilir (kulübü bilinemez); süper admine boş döner.
      function canReadPost() {
        let d = resource.data;
        return seesInside(d.clubId)
            && ((d.isDeleted == false && d.isHidden == false) || seesRemoved(d.clubId, d.authorId));
      }

      // Metin: kırpılmış hali boş olamaz (FieldValidators.postText ile aynı).
      function postTextOk(t) { return t is string && t.trim().size() > 0 && t.size() <= 1000; }   // limit: postTextMax
      // Başlık yalnızca duyuruda vardır (zorunlu); diğer türlerde yok / null.
      function titleOk(d) {
        return d.type == 'announcement'
            ? (d.title is string && d.title.trim().size() > 0 && d.title.size() <= 80)   // limit: postTitleMax
            : d.get('title', null) == null;
      }
      // `images[i]` = PostImageModel {path, w, h}. Yol yalnızca BU gönderinin klasörüdür (CD-39):
      // posts/{postId}/ + StoragePaths.fileNamePattern (parity.test.js karşılaştırır). `postId` desene
      // gömülür; kimlik karakter kümesi create'te sabitlenir (aşağıda).
      function imageOk(i) {
        return i is map && i.keys().hasOnly(['path', 'w', 'h'])
            && i.path is string
            && i.path.matches('posts/' + postId + '/\\d{8}T\\d{6}Z_[0-9a-f]{16}\\.(?:jpg|png|webp)')
            && i.w is int && i.w > 0 && i.h is int && i.h > 0;
      }
      function imageHeadOk(l) { return l.size() == 0 || imageOk(l[0]); }
      function imagesOk(l) {
        let t1 = tail(l);
        let t2 = tail(t1);
        let t3 = tail(t2);
        return l is list && l.size() <= 4   // limit: postImagesMax
            && imageHeadOk(l) && imageHeadOk(t1) && imageHeadOk(t2) && imageHeadOk(t3);
      }
      // Anket: seçenek kimlikleri sıralı ve sabittir (`o1`…`oN`) — oy kuralı kimliği seçenek sayısından
      // doğrular. `endsAt` istemci saatinden hesaplanır: sunucu zamanı + 1 / 3 / 7 gün, ± saat kayması (CD-32).
      function near(t, target) {
        return t >= target - duration.value(5, 'm') && t <= target + duration.value(5, 'm');   // limit: clockSkewTolerance
      }
      function pollEndsOk(t) {
        return t is timestamp
            && (near(t, request.time + duration.value(1, 'd'))   // limit: pollDurationsDays
                || near(t, request.time + duration.value(3, 'd'))   // limit: pollDurationsDays
                || near(t, request.time + duration.value(7, 'd')));   // limit: pollDurationsDays
      }
      function optionHeadOk(l, id) {
        return l.size() == 0
            || (l[0] is map && l[0].keys().hasOnly(['id', 'text']) && l[0].id == id
                && l[0].text is string && l[0].text.trim().size() > 0 && l[0].text.size() <= 60);   // limit: pollOptionTextMax
      }
      function pollShapeOk(p) {
        let o = p.options;
        let t1 = tail(o);
        let t2 = tail(t1);
        let t3 = tail(t2);
        return p is map && p.keys().hasOnly(['options', 'endsAt', 'showResultsAfterVote'])
            && p.showResultsAfterVote is bool
            && pollEndsOk(p.endsAt)
            && o is list && o.size() >= 2 && o.size() <= 4   // limit: pollOptionsMin, pollOptionsMax
            && optionHeadOk(o, 'o1') && optionHeadOk(t1, 'o2') && optionHeadOk(t2, 'o3') && optionHeadOk(t3, 'o4');
      }
      function pollOk(d) { return d.type == 'poll' ? pollShapeOk(d.poll) : d.get('poll', null) == null; }

      // Bildirimli duyuru (`pushSent`): günün sayacı AYNI işlemde tam +1 oynar ve BU gönderiyi gösterir.
      // Sayaç yolu sunucu gününden türetilir (istemcinin seçtiği gün belgesi değil): başka günün sayacını
      // artırarak sınır dolanılamaz. Sınır (`count <= 2`) ve sayaç biçimi sayaç kuralındadır; işaretçi iki
      // yönlüdür — tek sayaç artışıyla iki bildirimli duyuru yazılamaz. 1 erişim yolu: sayaç belgesi.
      function counterBumped(c) {
        let ref = counterPath(c + '_' + istanbulDayKey());
        let after = getAfter(ref).data;
        return after.get('lastPostRef', null) == 'posts/' + postId
            && after.count == (exists(ref) ? get(ref).data.count : 0) + 1;
      }
      // C — yalnızca kulüp yönetimi (yönetim kurulu / başkan), kendi adına. Sayaçlar sıfır, moderasyon ve
      // düzenleme alanları boş başlar. Günlük (activity) bu belgeyi ister; bu belge günlüğü istemez.
      function canCreatePost() {
        let d = request.resource.data;
        return d.keys().hasOnly(['clubId', 'authorId', 'type', 'title', 'text', 'images', 'poll', 'pinned',
                                 'pushSent', 'likes', 'likeCount', 'commentCount', 'lastCommentRef',
                                 'isHidden', 'hiddenBy', 'hiddenAt', 'editedAt',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            // kimlik görsel yolu desenine gömülür: düzenli ifade karakteri taşıyamaz
            && postId.matches('[A-Za-z0-9_-]+')
            && d.authorId == uid()
            && d.clubId is string
            // PostType (3)
            && d.type in ['post', 'announcement', 'poll']
            && postTextOk(d.text) && titleOk(d) && imagesOk(d.images) && pollOk(d)
            && d.pinned == false && d.isHidden == false
            && d.likes is list && d.likes.size() == 0 && d.likeCount == 0 && d.commentCount == 0
            && d.get('lastCommentRef', null) == null && d.get('hiddenBy', null) == null
            && d.get('hiddenAt', null) == null && d.get('editedAt', null) == null
            && d.pushSent is bool
            && activeUser() && isManager(d.clubId) && clubLive(d.clubId)
            && (d.pushSent == false || (d.type == 'announcement' && counterBumped(d.clubId)));
      }

      // U (düzenleme) — yazar, hâlâ yöneticiyken: `text`, `title`, `images` + `editedAt`. `type`, `poll`,
      // `pushSent`, `pinned`, sayaçlar ve moderasyon alanları beyaz listede yoktur → değişemez (anket
      // seçenekleri oy başladıktan sonra da değişmez). Yönetimden ayrılan yazar düzenleyemez.
      // Anket SORUSU ankette `text` alanıdır ve yayından sonra DEĞİŞMEZ: oylar değiştirilemez (TST-10) ve
      // üyelerce okunur — soru değişirse üyeler vermedikleri bir karara oy vermiş görünür (CD-141 madde 11).
      // Düzenleme de yayındır: askıdaki / silinmiş kulüpte reddedilir (`clubLive`) — yayın yasağı eski bir
      // gönderi yeniden yazılarak dolanılamaz. 3 erişim yolu: users/{uid} · üyelik · kulüp.
      function canEditPost() {
        let d = request.resource.data;
        return resource.data.isDeleted == false
            && resource.data.authorId == uid()
            && touches(['text', 'title', 'images', 'editedAt'])
            && d.editedAt == request.time
            && postTextOk(d.text) && titleOk(d) && imagesOk(d.images)
            && (resource.data.type != 'poll' || d.text == resource.data.text)
            && activeUser() && isManager(resource.data.clubId) && clubLive(resource.data.clubId);
      }

      // U (beğeni, PLAN §11.2b) — yalnızca `likes` + `likeCount`; `updatedAt` DEĞİŞMEZ (beyaz listede yok).
      // Oturum yalnızca KENDİ kimliğini ekler / çıkarır ve sayaç dizi uzunluğuyla birlikte tam ±1 oynar:
      // çift beğeni, başkasının kimliği, yinelenen eleman ve mutlak sayaç yazımı reddedilir.
      // Sayaç ayrıca İŞLEMİN TAMAMINDA tam `step` kadar oynar (`counterDelta`: `get` ↔ `getAfter`): aynı
      // işlemde aynı gönderiye yinelenen beğeni yazımı (`arrayUnion` diziyi bir kez büyütür, `increment` her
      // yazımda sayar) değerlendirme sırasından bağımsız reddedilir (CD-141 madde 11).
      // Danışman ve süper admin beğenemez (`isMember`). 3 erişim yolu: gönderi · users/{uid} · üyelik.
      function canLike() {
        let d = request.resource.data;
        let was = resource.data.likes;
        let step = delta('likeCount');
        return d.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount'])
            && resource.data.isDeleted == false && resource.data.isHidden == false
            && step in [-1, 1] && d.likeCount >= 0
            && d.likes is list && d.likes.size() - was.size() == step
            && d.likes.toSet().size() == d.likes.size()
            && ((step == 1 && !(uid() in was) && uid() in d.likes && d.likes.hasAll(was))
                || (step == -1 && uid() in was && !(uid() in d.likes) && was.hasAll(d.likes)))
            && counterDelta(postPath(postId), 'likeCount', step)
            && activeUser() && isMember(resource.data.clubId);
      }

      // U (sayaç dalı, PLAN §11.2b) — yalnızca `commentCount ±1` + `lastCommentRef` (+ `updatedAt`).
      // İşaretçinin gösterdiği yorum BU gönderinindir ve AYNI işlemde doğru geçişi yapar: +1 = yeni yorum ya
      // da geri alınan silme, −1 = silme. Aktör burada ayrıca denetlenmez: geçişi yapan yazımı yorum kuralı
      // yetkilendirir ve yorum kuralı da bu belgenin tam ±1 oynadığını ve KENDİSİNİ gösterdiğini görür
      // (iki yönlü bağ: tek artışla iki yorum, yorumsuz artış, başka gönderinin yorumu reddedilir).
      // İşaretçi rastgele yorum kimliğidir, kullanıcı kimliği taşımaz (CD-137 madde 8q dersi); bu belgeyi
      // okuyan kitle (`seesInside`) yorum listesini zaten görür. 1 erişim yolu: yorum belgesi.
      function commentMoved(ref, step) {
        let c = getAfter(ref).data;
        return c.postId == postId
            && ((step == 1 && c.isDeleted == false && (!exists(ref) || get(ref).data.isDeleted == true))
                || (step == -1 && c.isDeleted == true && get(ref).data.isDeleted == false));
      }
      function canBumpCommentCount() {
        let ref = request.resource.data.get('lastCommentRef', null);
        let step = delta('commentCount');
        return touches(['commentCount', 'lastCommentRef'])
            && step in [-1, 1] && request.resource.data.commentCount >= 0
            && ref is string && ref.matches('comments/[A-Za-z0-9_-]+')
            && commentMoved(commentPath(ref.split('/')[1]), step);
      }

      // U (sabitleme) — yönetim: yalnızca `pinned` (+ `updatedAt`), `clubs.pinnedPostId` ile AYNI işlemde.
      // `true`: gönderi silinmemiş ve gizli değil, kulüp yazım-sonrası BU gönderiyi gösterir; `false`: kulüp
      // artık bu gönderiyi göstermez. Yazım gerçek bir değişiklik taşır (`pinned` ya da kulübün gösterdiği
      // gönderi bu işlemde değişir): yalnızca `updatedAt` yenileyen boş yazım reddedilir.
      // 3 erişim yolu: kulüp (get + getAfter) · users/{uid} · üyelik.
      function canTogglePin() {
        let d = request.resource.data;
        let club = clubPath(resource.data.clubId);
        let pinnedId = getAfter(club).data.get('pinnedPostId', null);
        return touches(['pinned'])
            && (d.pinned != resource.data.pinned || get(club).data.get('pinnedPostId', null) != pinnedId)
            && ((d.pinned == true && resource.data.isDeleted == false && resource.data.isHidden == false
                 && pinnedId == postId)
                || (d.pinned == false && pinnedId != postId))
            && activeUser() && isManager(resource.data.clubId);
      }

      // U (soft delete) — kulüp yönetimi (herhangi bir gönderi) ya da süper admin. Sabit gönderi aynı
      // yazımda sabitlikten çıkar ve kulüp belgesi artık onu göstermez. Yorumlar, oylar, `commentCount` ve
      // duyuru sayacı değişmez (günlük hak iade edilmez).
      function canRemovePost() {
        return isSoftDelete(['pinned'])
            && request.resource.data.pinned == false
            && (resource.data.pinned == false
                || getAfter(clubPath(resource.data.clubId)).data.get('pinnedPostId', null) != postId)
            && (isSuper() || (activeUser() && isManager(resource.data.clubId)));
      }

      // U (restore) — süper admin ya da silmeyi yapan yönetici (Geri al). Gönderi yeniden sabitlenmez.
      function canRestorePost() {
        return isRestore([])
            && (isSuper() || (resource.data.get('deletedBy', null) == uid()
                              && activeUser() && isManager(resource.data.clubId)));
      }

      allow read: if canReadPost();
      allow create: if canCreatePost();
      allow update: if canLike() || canBumpCommentCount() || canEditPost() || canTogglePin()
                    || canRemovePost() || canRestorePost() || (isSuper() && isHideToggle());
      allow delete: if false;

      // 7 · posts/{postId}/votes/{uid} — T-19 · rules-spec §3.5
      // Yazma yolu: PostRepository.vote (C). Belge kimliği oy verenin uid'idir; alanlar `optionId`,
      // `createdAt` (BaseFields ve sayaç yok). Oy DEĞİŞTİRİLEMEZ ve silinemez (TST-10): U / D herkese kapalı.
      // Oy belgelerini gönderiyi görebilen herkes okur (sonuç sayımı; anonimlik arayüzdedir — rules-spec §9.2).
      match /votes/{voterId} {
        function votedPost() { return get(postPath(postId)).data; }

        // R — gönderiyle aynı görünürlük (gizli / silinmiş gönderinin oyları `seesRemoved`'a). Olmayan oyun
        // tekil okuması boş döner (myVote → null): kural oy belgesine değil gönderiye bakar.
        function canReadVotes() {
          let p = votedPost();
          return seesInside(p.clubId)
              && ((p.isDeleted == false && p.isHidden == false) || seesRemoved(p.clubId, p.authorId));
        }

        // C — kulübün yazma yetkili üyesi (danışman ve süper admin oy veremez), kendi adına, açık ankete,
        // var olan seçeneğe (kimlikler `o1`…`oN` — gönderi kuralı sabitler). İkinci `set` update sayılır ve
        // reddedilir. 3 erişim yolu: gönderi · users/{uid} · üyelik.
        function canVote() {
          let d = request.resource.data;
          let p = votedPost();
          return voterId == uid()
              && d.keys().hasOnly(['optionId', 'createdAt'])
              && d.createdAt == request.time
              && p.type == 'poll' && p.isDeleted == false && p.isHidden == false
              && request.time < p.poll.endsAt
              && d.optionId is string && d.optionId in ['o1', 'o2', 'o3', 'o4'][0:p.poll.options.size()]
              && activeUser() && isMember(p.clubId);
        }

        allow read: if canReadVotes();
        allow create: if canVote();
        allow update: if false;
        allow delete: if false;
      }
    }

    // 8 · comments/{commentId} — T-19 (şikayet çözümü T-37) · rules-spec §3.6
    // Yazma yolları: CommentRepository.add (C) · softDeleteComment · restoreComment — üçü de
    // `posts.commentCount ±1` + `lastCommentRef` ile AYNI batch'te · hide (süper admin).
    // Yorum düzenlenemez: `text`, `postId`, `clubId`, `authorId` hiçbir update beyaz listesinde yoktur.
    // Null olabilen alanlar (W-51): `hiddenBy`, `hiddenAt`.
    match /comments/{commentId} {
      // Gönderinin sayacı AYNI işlemde tam `step` kadar oynar VE işaretçisi BU yorumu gösterir (iki yönlü
      // bağ; karşılığı gönderideki `canBumpCommentCount`). 1 erişim yolu: gönderi (get + getAfter).
      function countMoved(p, step) {
        let after = getAfter(postPath(p)).data;
        return after.commentCount == get(postPath(p)).data.commentCount + step
            && after.get('lastCommentRef', null) == 'comments/' + commentId;
      }

      // R — kulübün içini gören; gizli / silinmiş yorumu yalnızca `seesRemoved` (yazarı, yönetim, süper
      // admin): moderasyonla kaldırılan yorumun içeriği ve kimin sildiği (`deletedBy`) üyelere sızmaz.
      // Yorum GÖNDERİSİNİN görünürlüğünü de izler (oylarla aynı — CD-141 madde 11): gizlenmiş / silinmiş
      // gönderinin yorum dizisini yalnızca o gönderiyi görebilen (gönderinin yazarı, yönetim, süper admin)
      // okur; yorumun kendi yazarı da okuyamaz. Liste sorgusu `postId`, `clubId`, `isDeleted == false`,
      // `isHidden == false` süzgeçlerini taşır (`postId` gönderi yolunu bağlar). Süper admin gönderiye
      // bakılmadan okur. En çok 3 erişim yolu: üyelik · gönderi · users/{uid}.
      function postOpen(p) {
        let post = get(postPath(p)).data;
        return (post.isDeleted == false && post.isHidden == false) || seesRemoved(post.clubId, post.authorId);
      }
      function canReadComment() {
        let d = resource.data;
        return seesInside(d.clubId)
            && ((d.isDeleted == false && d.isHidden == false) || seesRemoved(d.clubId, d.authorId))
            && (isSuper() || postOpen(d.postId));
      }

      // C — kulübün yazma yetkili üyesi (danışman ve süper admin yorum yazamaz), kendi adına, silinmemiş ve
      // gizlenmemiş gönderiye; `clubId` gönderinin kulübüdür. 3 erişim yolu: gönderi · users/{uid} · üyelik.
      function canAddComment() {
        let d = request.resource.data;
        let p = get(postPath(d.postId)).data;
        return d.keys().hasOnly(['postId', 'clubId', 'authorId', 'text', 'isHidden', 'hiddenBy', 'hiddenAt',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.authorId == uid()
            && d.postId is string && d.clubId is string
            // kırpılmış hali boş olamaz (FieldValidators.comment ile aynı)
            && d.text is string && d.text.trim().size() > 0 && d.text.size() <= 500   // limit: commentMax
            && d.isHidden == false && d.get('hiddenBy', null) == null && d.get('hiddenAt', null) == null
            && p.clubId == d.clubId && p.isDeleted == false && p.isHidden == false
            && countMoved(d.postId, 1)
            && activeUser() && isMember(d.clubId);
      }

      // Silme yetkisi: süper admin · kulüp yöneticisi (herhangi bir yorum) · yazarın kendisi (hâlâ yazma
      // yetkili üyeyken). Kulüpten ayrılan / çıkarılan yazar ve danışman silemez.
      function mayRemove() {
        let d = resource.data;
        return isSuper()
            || (activeUser() && ((d.authorId == uid() && isMember(d.clubId)) || isManager(d.clubId)));
      }

      // U (soft delete) — `commentCount −1` aynı batch'te. Çift silme reddedilir (`isSoftDelete`).
      function canRemoveComment() {
        return isSoftDelete([]) && countMoved(resource.data.postId, -1) && mayRemove();
      }

      // U (restore, Geri al) — `commentCount +1` aynı batch'te; süper admin ya da silmeyi yapan (silme
      // yetkisi sürüyorsa).
      function canRestoreComment() {
        return isRestore([]) && countMoved(resource.data.postId, 1)
            && (isSuper() || (resource.data.get('deletedBy', null) == uid() && mayRemove()));
      }

      allow read: if canReadComment();
      allow create: if canAddComment();
      allow update: if canRemoveComment() || canRestoreComment() || (isSuper() && isHideToggle());
      allow delete: if false;
    }

    // 9 · events/{eventId} — T-22 (bildirim dağıtımı ve yoklama / terfi YAZAN repository T-30)
    // rules-spec §3.7 · sözleşme docs/plans/T-22.md §6.
    // Yazma yolları: EventRepository.create / createDraft / duplicate (C; yayında + günlük) · update /
    // setRegistrationOpen / uploadCover (U içerik dalı) · publish · unpublish · cancel (U durum dalları) ·
    // softDeleteEvent / restoreEvent (yalnızca taslak) · RsvpRepository.join / cancel (U sayaç dalı: kendi) ·
    // AttendanceRepository.scanTicket / markAttended / promote (U sayaç dalı: yönetici — T-30 yazar).
    // Durum makinesi: draft → published (başlangıç gelecekte) · published → draft (yalnızca kayıtlı yokken, K-F) ·
    // published → cancelled (+ neden) · cancelled terminal. "Geçmiş" durum değildir.
    // Null olabilen alanlar (W-51): `placeId`, `placeText`, `capacity`, `cancelReason`, `coverPath`, `publishedAt`.
    // `lastRsvpRef` bu belgenin alanı DEĞİLDİR (W-64): belge doğrulanmış herkese açıktır, katılım kaydının
    // yolu (`rsvps/{eventId}_{userId}`) kimin katıldığını / vazgeçtiğini sızdırırdı — hiçbir beyaz listede yoktur.
    // Dal sırası: her dal önce ucuz ayırıcıya (beyaz liste, önceki / sonraki durum) bakar; erişim çağrıları sonra.
    match /events/{eventId} {
      // R — herkese açık (`public`) yayınlanmış / iptal edilmiş etkinliği doğrulanmış her kullanıcı okur
      // (askıdaki hesap dahil); `members` etkinliğini kulübün içini gören (`seesInside`); taslağı ve silinmiş
      // taslağı yalnızca kulüp yönetimi, danışman (`seesMgmt`: aktif hesap) ve süper admin. Liste sorgusu
      // çağıranın görebildiği kümeyi KENDİSİ sınırlar (rules-spec §6 EVT-01 / MGT-04; Rules süzgeç değildir).
      // Olmayan etkinliğin tekil okuması reddedilir (kulübü bilinemez); süper admine boş döner. Askıdaki
      // kulübün etkinliği burada süzülmez (rules-spec §9.5). Herkese açık okumada erişim çağrısı yoktur.
      function canReadEvent() {
        let d = resource.data;
        return emailOk()
            && ((d.isDeleted == false && d.status in ['published', 'cancelled'] && d.visibility == 'public')
                || isSuper()
                || (d.isDeleted == false && d.status in ['published', 'cancelled'] && seesInside(d.clubId))
                || seesMgmt(d.clubId));
      }

      // Sonuç belgenin içerik alanları (create: yeni belge · update: birleşmiş belge). Belge doğrulanmış
      // herkese açıktır: tip hatası başkalarının listesini bozmasın diye her alanın tipi burada sabitlenir
      // (EventModel.fromJson `checked: true`). Sınırlar FieldValidators.eventTitle / eventDesc / placeId /
      // placeText / capacity / eventEnd ile aynıdır.
      function eventContentOk(d) {
        return d.title is string && d.title.trim().size() > 0 && d.title.size() <= 80   // limit: eventTitleMax
            && d.desc is string && d.desc.size() <= 1000   // limit: eventDescMax
            // EventType (5)
            && d.type in ['egitim', 'sosyal', 'gezi', 'yarisma', 'konferans']
            && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt > d.startsAt
            // StaticTables.placeIds (pl01–pl10) biçimi
            && (d.get('placeId', null) == null || (d.placeId is string && d.placeId.matches('pl[0-9][0-9]')))
            && (d.get('placeText', null) == null || (d.placeText is string && d.placeText.size() <= 120))   // limit: placeTextMax
            // kontenjan: yok / null = sınırsız
            && (d.get('capacity', null) == null || (d.capacity is int && d.capacity >= 1))
            // EventVisibility (2)
            && d.visibility in ['public', 'members']
            // ClubPalette (3)
            && d.coverPalette in ['red', 'slate', 'bordeaux']
            // ClubPattern (4)
            && d.coverPattern in ['dots', 'lines', 'mountain', 'waves']
            && d.registrationOpen is bool && d.autoReminder is bool
            // StoragePaths.isEventCover: yalnızca BU etkinliğin klasörü + StoragePaths.fileNamePattern (CD-47;
            // parity.test.js karşılaştırır). Klasör ↔ kulüp bağı buradadır: Storage kuralı etkinlik belgesini
            // okumaz (W-73), yolu yalnızca etkinliğin kulübünün yöneticisi iliştirebilir.
            && (d.get('coverPath', null) == null
                || (d.coverPath is string
                    && d.coverPath.matches('events/' + eventId + '/\\d{8}T\\d{6}Z_[0-9a-f]{16}\\.(?:jpg|png|webp)')));
      }

      // Var olan etkinliği yazabilen: kulübün ETKİN yöneticisi (yönetim kurulu / başkan), hesabı aktif, kulüp
      // silinmemiş ve askıda değil. Danışman ve süper admin etkinlik YAZAMAZ.
      // 3 erişim yolu: users/{uid} · üyelik · kulüp.
      function managesEvent() {
        return activeUser() && isManager(resource.data.clubId) && clubLive(resource.data.clubId);
      }

      // C — yalnızca kulüp yönetimi, kendi adına; `draft` ya da doğrudan `published` (başlangıç gelecekte,
      // `publishedAt` sunucu zamanı). Sayaçlar sıfır; özel kapak (`coverPath`) ve iptal nedeni boş başlar
      // (kapak, etkinlik oluştuktan sonra yüklenir — CD-47). Kimlik kapak yolu desenine ve katılım kimliğine
      // gömülür: düzenli ifade karakteri taşıyamaz. Günlük (activity) bu belgeyi ister; bu belge günlüğü istemez.
      function canCreateEvent() {
        let d = request.resource.data;
        return d.keys().hasOnly(['clubId', 'createdBy', 'title', 'desc', 'type', 'startsAt', 'endsAt', 'placeId',
                                 'placeText', 'capacity', 'visibility', 'status', 'cancelReason', 'coverSeed',
                                 'coverPalette', 'coverPattern', 'coverPath', 'registrationOpen', 'autoReminder',
                                 'goingCount', 'waitlistCount', 'attendedCount', 'publishedAt',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && eventId.matches('[A-Za-z0-9_-]+')
            && d.createdBy == uid()
            && d.clubId is string
            && eventContentOk(d)
            && d.get('coverPath', null) == null && d.get('cancelReason', null) == null
            // FirestoreIds.eventCoverSeed
            && d.coverSeed == 'event-' + eventId
            && d.goingCount == 0 && d.waitlistCount == 0 && d.attendedCount == 0
            && ((d.status == 'draft' && d.get('publishedAt', null) == null)
                || (d.status == 'published' && d.publishedAt == request.time && d.startsAt > request.time))
            && activeUser() && isManager(d.clubId) && clubLive(d.clubId);
      }

      // U (içerik dalı) — update / setRegistrationOpen / uploadCover. `status`, `cancelReason`, `publishedAt`,
      // sayaçlar, `clubId`, `createdBy`, `coverSeed`, `createdAt` beyaz listede yoktur → değişemez (durum
      // geçişi içerik düzenlemesiyle aynı yazımda yapılamaz). İptal edilmiş ve silinmiş etkinlik düzenlenemez.
      // Kontenjan kayıtlı sayısının altına inemez. Yayındaki etkinliğin zamanı (`startsAt` / `endsAt`) yalnızca
      // etkinlik BAŞLAMADAN ve yeni başlangıç gelecekteyken değişir (domain-model §2.7 "yayında başlangıç
      // gelecekte"; CD-144 (10)): bitmiş etkinliğin bitişi ileri alınıp katılım / yoklama penceresi (K-G) yeniden
      // açılamaz, yayın koşulu başlangıç geçmişe çekilerek atlatılamaz. Taslakta serbest (yayın denetler).
      function canEditEvent() {
        let d = request.resource.data;
        return touches(['title', 'desc', 'type', 'startsAt', 'endsAt', 'placeId', 'placeText', 'capacity',
                        'visibility', 'registrationOpen', 'autoReminder', 'coverPalette', 'coverPattern',
                        'coverPath'])
            && resource.data.isDeleted == false
            && resource.data.status in ['draft', 'published']
            && eventContentOk(d)
            && (d.get('capacity', null) == null || d.capacity >= resource.data.goingCount)
            && (resource.data.status == 'draft'
                || !d.diff(resource.data).affectedKeys().hasAny(['startsAt', 'endsAt'])
                || (resource.data.startsAt > request.time && d.startsAt > request.time))
            && managesEvent();
      }

      // U (yayın) — `draft → published`: yalnızca `status` + `publishedAt` (sunucu zamanı); başlangıç gelecekte.
      function canPublishEvent() {
        let d = request.resource.data;
        return resource.data.status == 'draft' && d.status == 'published'
            && resource.data.isDeleted == false
            && touches(['status', 'publishedAt'])
            && d.publishedAt == request.time
            && resource.data.startsAt > request.time
            && managesEvent();
      }

      // U (yayından çek, TST-X19) — `published → draft`: yalnızca `status`; `publishedAt` korunur. Kayıtlı varken
      // reddedilir (K-F: `goingCount == 0`); bekleme listesindeki kayıtlar yerinde kalır.
      function canUnpublishEvent() {
        return resource.data.status == 'published' && request.resource.data.status == 'draft'
            && resource.data.isDeleted == false
            && touches(['status'])
            && resource.data.goingCount == 0
            && managesEvent();
      }

      // U (iptal, DLG-23) — `published → cancelled`: yalnızca `status` + `cancelReason` (kırpılmış hali dolu).
      // İptal geri dönmez (`cancelled` hiçbir dalın önceki durumu değildir); katılım kayıtları ve sayaçlar değişmez.
      function canCancelEvent() {
        let d = request.resource.data;
        return resource.data.status == 'published' && d.status == 'cancelled'
            && resource.data.isDeleted == false
            && touches(['status', 'cancelReason'])
            && d.cancelReason is string && d.cancelReason.trim().size() > 0
            && d.cancelReason.size() <= 300   // limit: adminReasonMax
            && managesEvent();
      }

      // U (soft delete / restore) — yalnızca TASLAK (DLG-31; yayındaki etkinlik iptal edilir). Geri almayı
      // yalnızca silen yönetici (hâlâ yöneticiyken) yapar (TST-45). Süper admin etkinlik silemez.
      function canRemoveEvent() {
        return isSoftDelete([]) && resource.data.status == 'draft' && managesEvent();
      }
      function canRestoreEvent() {
        return isRestore([]) && resource.data.status == 'draft'
            && resource.data.get('deletedBy', null) == uid() && managesEvent();
      }

      // ── U (sayaç dalı, PLAN §11.2b; sözleşme §6.4) ──────────────────────────────────────────
      // Yalnızca `goingCount` / `waitlistCount` / `attendedCount` (+ `updatedAt`), katılım kaydıyla AYNI işlemde.
      // İki yönlü bağ: bu dal eşlik eden kaydın işlemin tamamında (`exists` / `get` → `getAfter`) doğru geçişi
      // yaptığını, kayıt kuralı da (`eventCountersMoved`) sayaçların işlemin tamamında TAM bu kadar oynadığını
      // görür — sayaçsız kayıt, kayıtsız sayaç, ±1 dışı delta ve tek artışla iki kayıt reddedilir.
      // Aktör burada ayrıca yetkilendirilmez (kendi dalı): geçişi yapan yazımı kayıt kuralı yetkilendirir
      // (vazgeçmede `activeUser` / `clubLive` aranmaz — askıdaki hesap ve askıdaki kulübün katılımcısı vazgeçebilir).
      function countersSane() {
        let d = request.resource.data;
        return d.goingCount >= 0 && d.waitlistCount >= 0 && d.attendedCount >= 0
            && d.attendedCount <= d.goingCount;
      }
      // KONTENJAN: kayıtlı sayısı arttığında yazım-sonrası değer kontenjanı aşamaz. Anahtarsız / null
      // kontenjan sınırsızdır (W-51: istemci null alanı hiç yazmaz).
      function capacityHolds() {
        return resource.data.get('capacity', null) == null
            || request.resource.data.goingCount <= resource.data.capacity;
      }
      // Kendi katılımında `going`: yer var VE bekleme listesi boş (CD-144 (10) — boşalan yer önce bekleyenindir;
      // Mod C'de yönetici terfi eder). Bekleyen vazgeçip yeniden katılarak, yeni gelen de sırayı atlayarak
      // kayıtlı olamaz. Sınırsız etkinlikte bekleme listesi yoktur.
      function ownGoingAllowed() {
        return resource.data.get('capacity', null) == null
            || (capacityHolds() && resource.data.waitlistCount == 0);
      }
      // Bekleme listesine yalnızca kontenjanlı etkinlikte, kontenjan DOLUYKEN ya da önde bekleyen varken girilir
      // (`EventModel.joinsWaitlist` ile aynı; işlem etkinliği okur, çakışmada yeniden koşar).
      function joinsWaitlist() {
        return resource.data.get('capacity', null) != null
            && (resource.data.goingCount >= resource.data.capacity || resource.data.waitlistCount > 0);
      }

      // Kendi dalı — eşlik eden kayıt oturumun BU etkinlikteki kaydıdır; yolu oturumdan türetilir
      // (`rsvps/{eventId}_{uid}`), herkese açık bu belgeye YAZILMAZ (W-64). Okunan kaydın `eventId` / `userId`
      // alanları da karşılaştırılır (kimlik birleşimi belirsizliği).
      //   (+1, 0, 0) yok | cancelled → going      (0, +1, 0) yok | cancelled → waitlist
      //   (−1, 0, 0) going → cancelled            (0, −1, 0) waitlist → cancelled
      // 1 erişim yolu: katılım kaydı (getAfter + exists / get).
      function canBumpOwnRsvpCounters() {
        let going = delta('goingCount');
        let waitlist = delta('waitlistCount');
        let ref = rsvpPath(eventId, uid());
        let r = getAfter(ref).data;
        let was = exists(ref) ? get(ref).data.status : 'none';
        return touches(['goingCount', 'waitlistCount', 'attendedCount'])
            && delta('attendedCount') == 0
            && countersSane()
            && r.eventId == eventId && r.userId == uid()
            && ((going == 1 && waitlist == 0 && r.status == 'going' && was in ['none', 'cancelled'] && ownGoingAllowed())
                || (going == 0 && waitlist == 1 && r.status == 'waitlist' && was in ['none', 'cancelled'] && joinsWaitlist())
                || (going == -1 && waitlist == 0 && r.status == 'cancelled' && was == 'going')
                || (going == 0 && waitlist == -1 && r.status == 'cancelled' && was == 'waitlist'));
      }

      // Yönetici dalı (yoklama ve terfi; yazan repository T-30) — aktör kaydın sahibi değildir; eşlik eden
      // kaydı, AYNI işlemde yazılan yan belgenin işaretçisi gösterir (`events/{eventId}/private/counter`,
      // `updatedAt == request.time`). İşaretçideki kayıt BU etkinliğindir ve yolu kendi alanlarından yeniden
      // kurulur (`rsvps/{eventId}_{userId}`): başka etkinliğin ya da kimlik kaydırılmış bir kayıt gösterilemez.
      //   (0, 0, +1) going → attended     (0, 0, −1) attended → going     (+1, −1, 0) waitlist → going (terfi)
      // Yoklama `goingCount`'u değiştirmez (kayıtlı = going ∪ attended — CD-130). Etkinliğin durumu ve yoklama
      // penceresi kayıt kuralındadır. 4 erişim yolu: yan belge · katılım kaydı · users/{uid} · üyelik.
      function canBumpManagedRsvpCounters() {
        let going = delta('goingCount');
        let waitlist = delta('waitlistCount');
        let attended = delta('attendedCount');
        let side = getAfter(eventCounterPath(eventId)).data;
        let pointer = side.lastRsvpRef;
        let ref = rsvpDoc(pointer.split('/')[1]);
        let r = getAfter(ref).data;
        let was = get(ref).data.status;
        return touches(['goingCount', 'waitlistCount', 'attendedCount'])
            && countersSane()
            && side.updatedAt == request.time && side.clubId == resource.data.clubId
            && pointer is string && pointer.matches('rsvps/[^/]+')
            && r.eventId == eventId && pointer == 'rsvps/' + eventId + '_' + r.userId
            && ((going == 0 && waitlist == 0 && attended == 1 && was == 'going' && r.status == 'attended')
                || (going == 0 && waitlist == 0 && attended == -1 && was == 'attended' && r.status == 'going')
                || (going == 1 && waitlist == -1 && attended == 0 && was == 'waitlist' && r.status == 'going'
                    && capacityHolds()))
            && activeUser() && isManager(resource.data.clubId);
      }

      allow read: if canReadEvent();
      allow create: if canCreateEvent();
      allow update: if canBumpOwnRsvpCounters() || canBumpManagedRsvpCounters() || canEditEvent()
                    || canPublishEvent() || canUnpublishEvent() || canCancelEvent()
                    || canRemoveEvent() || canRestoreEvent();
      allow delete: if false;

      // 9b · events/{eventId}/private/counter — T-22 (yazan repository T-30) · sözleşme §6.5 (W-64)
      // Yönetici sayaç dallarının (yoklama, terfi) işaretçisi: alanlar `clubId`, `lastRsvpRef`
      // (`rsvps/{eventId}_{userId}`), `updatedAt` (BaseFields yok). Etkinlik belgesi doğrulanmış herkese
      // açıktır, bu belge yalnızca kulüp yönetimine / danışmana / süper admine (`seesMgmt`) — onlar katılımcı
      // listesini zaten görür. Belge TEK BAŞINA yazılamaz: yalnızca etkinliğin yönetici sayaç bileşimiyle aynı
      // işlemde (etkinliğin sayaç dalı da bu belgenin o işlemde yazıldığını ve gösterdiği kaydın doğru geçişi
      // yaptığını görür). Koleksiyon grubu okuması kapalıdır (aşağıda).
      match /private/{docId} {
        // Etkinliğin sayaçları İŞLEMİN TAMAMINDA bir yönetici bileşimi kadar oynadı mı?
        function managedMove(was, now) {
          let going = now.goingCount - was.goingCount;
          let waitlist = now.waitlistCount - was.waitlistCount;
          let attended = now.attendedCount - was.attendedCount;
          return (going == 0 && waitlist == 0 && attended in [-1, 1])
              || (going == 1 && waitlist == -1 && attended == 0);
        }
        // 3 erişim yolu: etkinlik (get + getAfter) · users/{uid} · üyelik.
        function canPointCounter() {
          let d = request.resource.data;
          let e = get(eventPath(eventId)).data;
          return docId == 'counter'
              && d.keys().hasOnly(['clubId', 'lastRsvpRef', 'updatedAt'])
              && d.updatedAt == request.time
              && d.clubId == e.clubId
              && d.lastRsvpRef is string && d.lastRsvpRef.matches('rsvps/[^/]+')
              && managedMove(e, getAfter(eventPath(eventId)).data)
              && activeUser() && isManager(e.clubId);
        }

        allow get: if docId == 'counter' && seesMgmt(resource.data.clubId);
        allow list: if false;
        allow create: if canPointCounter();
        allow update: if canPointCounter();
        allow delete: if false;
      }
    }

    // 10 · rsvps/{eventId}_{userId} — T-22 (yoklama / terfi YAZAN repository T-30) · rules-spec §3.8 ·
    // sözleşme docs/plans/T-22.md §6.3.
    // Yazma yolları: RsvpRepository.join (C; vazgeçilmiş kayıt varsa U yeniden katılım) · cancel · setReminder ·
    // AttendanceRepository.scanTicket / markAttended (U yoklama) · promote (U terfi) — durum değiştiren her
    // yazım `events` sayaçlarıyla AYNI işlemdedir.
    // Belge silinmez ve soft delete edilmez: vazgeçme bir durum geçişidir (`cancelled`); `isDeleted` hiçbir
    // update beyaz listesinde yoktur. `eventId`, `clubId`, `userId`, `ticketCode`, `createdAt` da öyle —
    // bilet kodu yalnızca ilk katılımda yazılır ve yalnızca bu belgede durur (sahibi + `seesMgmt` okur).
    // Null olabilen alanlar (W-51): `waitlistAt`, `scannedAt`, `scannedBy`.
    match /rsvps/{rsvpId} {
      // Belge kimliği oturumun uid'iyle mi bitiyor (`…_<uid>`)? Yalnızca OLMAYAN belgenin tekil okumasında
      // kullanılır (var olan belgede sahiplik `userId` alanından okunur).
      function ownRsvpId() {
        let suffix = '_' + uid();
        return rsvpId.size() > suffix.size()
            && rsvpId[rsvpId.size() - suffix.size():rsvpId.size()] == suffix;
      }

      // R — sahibi (askıdaki hesap dahil), kulüp yönetimi / danışman (aktif hesap) ve süper admin. Sıradan üye
      // ve başka kulübün yöneticisi katılımcıları ve bilet kodlarını OKUYAMAZ.
      function canReadRsvp() {
        return (emailOk() && resource.data.userId == uid()) || seesMgmt(resource.data.clubId);
      }

      // ReminderOption (4 — CD-34; `settings.reminderTime` yalnızca 1h / 1d kalır)
      function reminderOk(r) { return r in ['none', '15m', '1h', '1d']; }
      // FirestoreIds.ticketCodePattern (32'lik alfabe: I, O, 0, 1 yok)
      function ticketOk(c) { return c is string && c.matches('GU-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}'); }

      // Katılım kabul eden etkinlik (`e` = işlem ÖNCESİ belge): silinmemiş, yayında, kayıt açık, bitmemiş
      // (sunucu saati), kaydın kulübüyle aynı kulübün; `members` görünürlükte yalnızca yazma yetkili üye
      // (danışman ve süper admin `isMember` değildir); kulüp silinmemiş ve askıda değil.
      // En çok 2 erişim yolu: üyelik (yalnızca `members`) · kulüp.
      function joinable(e, club) {
        return e.isDeleted == false && e.status == 'published' && e.registrationOpen == true
            && e.endsAt > request.time
            && e.clubId == club
            && (e.visibility == 'public' || isMember(e.clubId))
            && clubLive(e.clubId);
      }
      // Katılımın sonucu: `going` (bekleme anı boş, kayıtlı +1) ya da `waitlist` (bekleme anı sunucu zamanı,
      // bekleyen +1). Hangisinin geçerli olduğunu (kontenjan) etkinliğin sayaç dalı belirler.
      function joinedNow(d, event) {
        return (d.status == 'going' && d.get('waitlistAt', null) == null && eventCountersMoved(event, 1, 0, 0))
            || (d.status == 'waitlist' && d.waitlistAt == request.time && eventCountersMoved(event, 0, 1, 0));
      }

      // C (Katıl) — aktif kullanıcı, kendi adına; kimlik `eventId_userId` ile birebirdir ve alanlar eşleşir.
      // Yoklama alanları boş başlar. En çok 4 erişim yolu: etkinlik (get + getAfter) · users/{uid} · üyelik · kulüp.
      function canJoin() {
        let d = request.resource.data;
        return d.keys().hasOnly(['eventId', 'clubId', 'userId', 'status', 'reminder', 'ticketCode',
                                 'waitlistAt', 'scannedAt', 'scannedBy',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.userId == uid()
            && d.eventId is string && d.clubId is string
            && rsvpId == d.eventId + '_' + d.userId
            && reminderOk(d.reminder) && ticketOk(d.ticketCode)
            && d.get('scannedAt', null) == null && d.get('scannedBy', null) == null
            && joinedNow(d, d.eventId)
            && activeUser() && joinable(get(eventPath(d.eventId)).data, d.clubId);
      }

      // U (yeniden katıl) — `cancelled → going | waitlist`: yalnızca `status`, `reminder`, `waitlistAt`;
      // `ticketCode` ve `createdAt` AYNI kalır. Katılım koşulları ilk katılımla aynıdır.
      function canRejoin() {
        let d = request.resource.data;
        return resource.data.status == 'cancelled' && d.status in ['going', 'waitlist']
            && resource.data.userId == uid()
            && touches(['status', 'reminder', 'waitlistAt'])
            && reminderOk(d.reminder)
            && joinedNow(d, resource.data.eventId)
            && activeUser() && joinable(get(eventPath(resource.data.eventId)).data, resource.data.clubId);
      }

      // U (vazgeç, DLG-14) — `going | waitlist → cancelled`: yalnızca `status`; ilgili sayaç −1. `activeUser`
      // İSTENMEZ (askıdaki / hesabını silen kullanıcı vazgeçebilir — T-29); etkinliğin durumu ve kulübün askısı
      // aranmaz. Etkinlik BİTMEDEN (`endsAt > request.time`; EVT-02 / EVT-03 "Vazgeç" de yalnızca o zaman görünür):
      // bitmiş etkinlikte "Gelmedin" kaydı iptale çevrilip `goingCount` düşürülerek yoklama oranı şişirilemez
      // (CD-144 (10)). Yoklaması alınmış kayıttan (`attended`) vazgeçilemez. Boşalan yere kimse otomatik alınmaz.
      // 1 erişim yolu: etkinlik (get + getAfter).
      function canCancelRsvp() {
        let was = resource.data.status;
        return request.resource.data.status == 'cancelled' && was in ['going', 'waitlist']
            && emailOk() && resource.data.userId == uid()
            && touches(['status'])
            && get(eventPath(resource.data.eventId)).data.endsAt > request.time
            && ((was == 'going' && eventCountersMoved(resource.data.eventId, -1, 0, 0))
                || (was == 'waitlist' && eventCountersMoved(resource.data.eventId, 0, -1, 0)));
      }

      // U (hatırlatma, SHT-13) — yalnızca `reminder`, kayıt `going` / `waitlist` iken. Sayaç oynamaz.
      function canSetReminder() {
        return resource.data.userId == uid() && resource.data.status in ['going', 'waitlist']
            && touches(['reminder'])
            && reminderOk(request.resource.data.reminder)
            && activeUser();
      }

      // Yönetici geçişlerinin ortak koşulu: yan belge AYNI işlemde yazılır ve BU kaydı gösterir (tek işaretçi →
      // tek sayaç oynamasıyla iki kayıt yazılamaz); aktör etkinliğin kulübünün etkin yöneticisidir (danışman ve
      // süper admin değil). 3 erişim yolu: yan belge · users/{uid} · üyelik.
      function managedHere(e) {
        let side = getAfter(eventCounterPath(resource.data.eventId)).data;
        return e.clubId == resource.data.clubId && e.isDeleted == false && e.status == 'published'
            && side.updatedAt == request.time && side.lastRsvpRef == 'rsvps/' + rsvpId
            && activeUser() && isManager(e.clubId);
      }

      // U (yoklama, MGT-06 / MGT-07) — `going → attended` (`scannedAt` sunucu zamanı, `scannedBy` oturum) ve geri
      // alma `attended → going` (ikisi boşalır); `attendedCount ±1`. Yalnızca yoklama penceresinde (K-G):
      // başlangıçtan 2 sa önce … bitişten 6 sa sonra, iki uç dahil (EventModel.attendanceWindow ile aynı).
      function canMarkAttendance() {
        let d = request.resource.data;
        let was = resource.data.status;
        let e = get(eventPath(resource.data.eventId)).data;
        return ((was == 'going' && d.status == 'attended' && d.scannedAt == request.time && d.scannedBy == uid()
                 && eventCountersMoved(resource.data.eventId, 0, 0, 1))
                || (was == 'attended' && d.status == 'going' && d.get('scannedAt', null) == null
                    && d.get('scannedBy', null) == null && eventCountersMoved(resource.data.eventId, 0, 0, -1)))
            && touches(['status', 'scannedAt', 'scannedBy'])
            && request.time >= e.startsAt - duration.value(2, 'h')   // limit: attendanceWindowBefore
            && request.time <= e.endsAt + duration.value(6, 'h')   // limit: attendanceWindowAfter
            && managedHere(e);
      }

      // U (terfi, MGT-06 "Kayıtlıya al") — `waitlist → going`: yalnızca `status`; etkinlik TEK yazımda
      // `goingCount +1` ve `waitlistCount −1` (kontenjan etkinliğin sayaç dalında). Mod C'de terfi yalnızca
      // yönetici elledir: bekleyen kendini terfi ettiremez (sahibine `waitlist → going` dalı yoktur).
      function canPromote() {
        let e = get(eventPath(resource.data.eventId)).data;
        return resource.data.status == 'waitlist' && request.resource.data.status == 'going'
            && touches(['status'])
            && e.endsAt > request.time
            && eventCountersMoved(resource.data.eventId, 1, -1, 0)
            && managedHere(e);
      }

      // Olmayan kendi kaydının tekil okuması boş döner (getMine → null; katılım işleminin ilk okuması):
      // `resource == null` yalnızca `…_<uid>` kimliğinde izinlidir (başkasının katılıp katılmadığı yoklanamaz).
      allow get: if (resource == null && emailOk() && ownRsvpId()) || canReadRsvp();
      // Sorgu sözleşmesi (rules-spec §6): `userId == uid` (EVT-04 / PRF-03) · `eventId` + `clubId` (MGT-06,
      // bilet kodu araması, bekleme sırası — yalnızca `seesMgmt`). Süzgeçsiz sorgu yalnızca süper admine açıktır.
      allow list: if canReadRsvp();
      allow create: if canJoin();
      allow update: if canSetReminder() || canCancelRsvp() || canRejoin() || canMarkAttendance() || canPromote();
      allow delete: if false;
    }

    // 11 · notifications/{notificationId} — T-25 · rules-spec §3.9 · sözleşme docs/plans/T-25.md §6 (a, b, f, g)
    // Yazma yolları: ClientFanOutDispatcher → NotificationWriter.addToBatch (kritik, asıl yazımla aynı batch) /
    // createMany (fan-out parçası, tek batch) · NotificationRepository.createSelf (`event_reminder`, C) ·
    // markRead / markAllRead / softDeleteNotification / restoreNotification (U, sahibi).
    // Belge şeması (CD-147: Mod F'de sunucu tetikleyicisi aynı alanları yazar): `userId` (alıcı), `type`, `refs`
    // (7'lik beyaz liste), `read`, ortak alanlar. Metin, aktör / yazar alanı YOKTUR (alıcı dilinde ARB'den üretilir).
    // Kimlik (W-49): `{type}_{eventKey}_{userId}`; aynı olayın tekrarı aynı belge = ikinci `set` update sayılır ve
    // yalnızca sahibine açıktır → ret. Anahtar (ClientFanOutDispatcher): tek seferlik olaylarda olayın
    // kimliği — `announcement` postId, `event_cancelled` eventId, `application_received` `{clubId}_{uid}_{priorCount}`
    // (tam eşitlik); tekrarlanabilen olaylarda (`event_new`, `waitlist_promoted`) olay başına rastgele 20 karakter
    // `[A-Za-z0-9]`; `event_reminder`'da `event_reminder_{eventId}_{uid}` (tam eşitlik).
    // Kimlik erişim çağrısı harcamadan dizgi olarak doğrulanır; yolu kimlikten kurulan her okuma okunan
    // belgenin alanlarını da karşılaştırır (birleşim belirsizliği — `a_b` + `c` = `a` + `b_c`).
    // Kapalı türler (dal üreticisiyle aynı commit'te açılır): `application_approved`, `application_rejected`,
    // `removed_from_club`, `role_changed` (T-30) · `report_resolved` (T-37) · `new_report` (hiç üretilmez —
    // CD-37) · `system` (yalnızca Admin SDK). Fan-out türlerinde alıcının üyeliği DOĞRULANMAZ (bütçe:
    // alıcı başına `get` yok) — ETKİN kulübün yöneticisinin taze olay penceresindeki spam'i kabul edilmiş
    // sınırlamadır (rules-spec §9.3, K-J: kabul — CD-65; kota kuralı yazılmaz). Başvuran (güvenilmeyen öğrenci)
    // başvuru başına yönetici başına en çok bir belge yazabilir (CD-148).
    match /notifications/{notificationId} {
      // Belge kimliği oturumun uid'iyle mi bitiyor (`…_<uid>`)? Yalnızca OLMAYAN belgenin tekil okumasında
      // kullanılır (createSelf ön okuması); var olan belgede sahiplik `userId` alanından okunur.
      function ownNotificationId() {
        let suffix = '_' + uid();
        return notificationId.size() > suffix.size()
            && notificationId[notificationId.size() - suffix.size():notificationId.size()] == suffix;
      }

      // `refs` (NotificationRefsModel): türün zorunluları (`requiredFor`) dolu dizgi; diğerleri anahtarsız
      // (istemci, include_if_null: false) ya da açık `null` (seed) — W-51.
      function refOk(r, required, k) {
        return k in required ? (r.get(k, null) is string && r.get(k, '').size() > 0) : r.get(k, null) == null;
      }
      function refsOk(r, required) {
        return r is map
            && r.keys().hasOnly(['clubId', 'eventId', 'postId', 'applicantId', 'reportId', 'role', 'textKey'])
            && refOk(r, required, 'clubId') && refOk(r, required, 'eventId') && refOk(r, required, 'postId')
            && refOk(r, required, 'applicantId') && refOk(r, required, 'reportId') && refOk(r, required, 'role')
            && refOk(r, required, 'textKey');
      }

      // Dağıtıcı kimliği `{type}_{eventKey}_{userId}` (FirestoreIds.notification; NotificationWriter.newEventKey):
      // tür öneki ve alıcı soneki belgenin alanlarıyla birebir, arada tam 20 karakter `[A-Za-z0-9]` anahtar.
      function keyedIdOk(d) {
        let head = d.type + '_';
        let tail = '_' + d.userId;
        let n = notificationId.size();
        return n > head.size() + tail.size()
            && notificationId[0:head.size()] == head
            && notificationId[n - tail.size():n] == tail
            && notificationId[head.size():n - tail.size()].matches('[A-Za-z0-9]{20}');
      }

      // Başvuranın kendi `pending` üyeliği (yol oturumdan; alanlar karşılaştırılır) ve kimliğin BU başvuruya
      // bağlanması (T-25 güvenlik incelemesi): `application_received_{clubId}_{uid}_{priorCount}_{alıcı}`
      // (FirestoreIds.applicationEventKey). Her başvuru (M1 / M3 / M4 `priorCount` +1) yönetici başına TEK belge
      // üretir; aynı başvuruyla ikinci bildirim var olan belgeye düşer (update → ret) — bekleyen başvuran
      // yöneticinin gelen kutusunu dolduramaz.
      function applicantPending(c, d) {
        let m = get(mPath(c, uid())).data;
        return m.clubId == c && m.userId == uid() && m.status == 'pending'
            && notificationId == 'application_received_' + c + '_' + uid() + '_' + string(m.get('priorCount', 0))
                                 + '_' + d.userId;
      }
      // Alıcı kulübün ETKİN yönetim kurulu üyesi / başkanı (danışman alıcı değildir). Yol alıcıya göre
      // değiştiğinden bu tür alıcı başına ayrı batch'le yazılır (parça boyu 1).
      function managerRecipient(c, u) {
        let m = get(mPath(c, u)).data;
        return m.clubId == c && m.userId == u && m.status == 'active' && m.role in ['board', 'president'];
      }
      // Bildirimli duyuru: bu kulübün, oturumun yazdığı, silinmemiş ve gizlenmemiş `announcement && pushSent`
      // gönderisi (gönderi oluşturma T-19 `announcementCounters` dalında günlük sınırdan geçmiştir; ek kota yok —
      // K-J). `pushSent` oluşturmadan sonra değişmez → duyuru tek seferliktir.
      function announced(c, p) {
        let post = get(postPath(p)).data;
        return post.clubId == c && post.type == 'announcement' && post.pushSent == true
            && post.isDeleted == false && post.isHidden == false && post.authorId == uid();
      }
      // Etkinlik bu kulübün, silinmemiş ve beklenen durumda (`published` → event_new, `cancelled` → event_cancelled).
      function eventIs(c, e, status) {
        let ev = get(eventPath(e)).data;
        return ev.clubId == c && ev.isDeleted == false && ev.status == status;
      }
      // `event_new` yalnızca (yeniden) yayından sonraki pencerede: yayın `publishedAt`'i sunucu zamanıyla yeniler
      // (yayından çekip yeniden yayın meşru tekrardır); eski yayının bildirimi sonradan yeniden itilemez.
      function freshlyPublished(e) {
        return get(eventPath(e)).data.publishedAt + duration.value(10, 'm') > request.time;   // limit: notificationEventNewWindow
      }
      // Terfi AYNI batch'te: alıcının kaydı `waitlist → going` (getAfter + get; alanlar karşılaştırılır).
      function promotedNow(c, e, u) {
        let now = getAfter(rsvpPath(e, u)).data;
        return now.eventId == e && now.userId == u && now.clubId == c && now.status == 'going'
            && get(rsvpPath(e, u)).data.status == 'waitlist';
      }

      // Tür dalları (docs/plans/T-25.md §6 c, f). Her dal önce ucuz ayırıcıya (`type`) ve dizgi denetimlerine
      // bakar, erişim çağrıları sonra gelir. Kimlik türe göre (T-25 güvenlik incelemesi — bildirim GERÇEK ve
      // TEK SEFERLİK bir olaya bağlıdır): tek seferlik olaylarda olay anahtarı olayın kendi kimliğidir
      // (`announcement_{postId}_…`, `event_cancelled_{eventId}_…` — iptal geri dönmez; başvuruda üyelik
      // `priorCount`'u), tekrarlanabilen olaylarda (`event_new` yeniden yayın, `waitlist_promoted` terfi) rastgele
      // 20 karakter (`keyedIdOk`) + olayın tazeliği (yayın penceresi / aynı batch'teki terfi). Yönetici dalları
      // askıdaki / silinmiş kulüpte kapalıdır (`clubLive`, diğer yönetici yazımlarıyla aynı).
      // Erişim yolları (tekil): users/{uid} · üyelik · olay belgesi · kulüp = 4; `application_received`:
      // users/{uid} · kendi üyeliği · alıcının üyeliği = 3. Parçadaki tüm belgeler aynı yolları okur → parça
      // boyu Limits.notificationFanOutChunkSize (budget/fanout_budget.test.js).
      function kindOk(d, t, r) {
        return (t == 'application_received' && refsOk(r, ['clubId', 'applicantId'])
                && r.applicantId == uid() && d.userId != uid()
                && applicantPending(r.clubId, d) && managerRecipient(r.clubId, d.userId))
            || (t == 'announcement' && refsOk(r, ['clubId', 'postId'])
                && notificationId == 'announcement_' + r.postId + '_' + d.userId
                && isManager(r.clubId) && announced(r.clubId, r.postId) && clubLive(r.clubId))
            || (t == 'event_new' && refsOk(r, ['clubId', 'eventId']) && keyedIdOk(d)
                && isManager(r.clubId) && eventIs(r.clubId, r.eventId, 'published') && freshlyPublished(r.eventId)
                && clubLive(r.clubId))
            || (t == 'event_cancelled' && refsOk(r, ['clubId', 'eventId'])
                && notificationId == 'event_cancelled_' + r.eventId + '_' + d.userId
                && isManager(r.clubId) && eventIs(r.clubId, r.eventId, 'cancelled') && clubLive(r.clubId))
            || (t == 'waitlist_promoted' && refsOk(r, ['clubId', 'eventId']) && keyedIdOk(d)
                && isManager(r.clubId) && promotedNow(r.clubId, r.eventId, d.userId) && clubLive(r.clubId));
      }

      // C — ortak: alan beyaz listesi, ortak alanlar (sunucu zamanı), `read == false`, alıcı dolu dizgi; aktif
      // hesap. `event_reminder` (CD-44): cihaz yalnızca KENDİ belgesini yazar, kimlik tam eşittir (başka türün
      // `event_reminder_…` kimliğini işgal etmesi ve başkasının hatırlatıcısını önceden yazmak engellenir).
      function canCreateNotification() {
        let d = request.resource.data;
        let t = d.type;
        let r = d.refs;
        return d.keys().hasOnly(['userId', 'type', 'refs', 'read',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.read == false
            && d.userId is string && d.userId.size() > 0
            && t is string
            && ((t == 'event_reminder' && d.userId == uid() && refsOk(r, ['clubId', 'eventId'])
                 && notificationId == 'event_reminder_' + r.eventId + '_' + uid())
                || (t in ['application_received', 'announcement', 'event_new', 'event_cancelled', 'waitlist_promoted']
                    && kindOk(d, t, r)))
            && activeUser();
      }

      // U (sahibi; askıdaki hesap dahil): (1) okundu — yalnızca `read` (+ `updatedAt`), sonuç `true` (zaten
      // okunmuşa da geçer, okunmamışa dönüş yok; markAllRead parçalı batch); (2) soft delete; (3) geri al —
      // yalnızca silen (kendisi). Tür, alıcı, `refs` ve `createdAt` hiçbir dalda değişemez.
      function canUpdateNotification() {
        return emailOk() && resource.data.userId == uid()
            && ((touches(['read']) && request.resource.data.read == true)
                || isSoftDelete([])
                || (isRestore([]) && resource.data.deletedBy == uid()));
      }

      // R — yalnızca sahibi (silinmişler dahil — Geri al); süper admin dahil başkası okuyamaz. Olmayan KENDİ
      // belgesinin tekil okuması boş döner (`resource == null`, kimlik `…_<uid>`; createSelf ön okuması).
      // Sorgu sözleşmesi (rules-spec §6 NTF-01): `userId == uid`, `isDeleted == false`, `createdAt` ↓, `limit`.
      allow get: if (resource == null && emailOk() && ownNotificationId())
                 || (emailOk() && resource.data.userId == uid());
      allow list: if emailOk() && resource.data.userId == uid();
      allow create: if canCreateNotification();
      allow update: if canUpdateNotification();
      allow delete: if false;
    }

    // 12 · reports/{reporterId}_{targetType}_{targetId} — T-15 (çözme T-37) · rules-spec §3.10
    // Yazma yolu: ReportRepository.report (C; 2 erişim yolu: users/{uid} · hedef belge). Okuma: hasReported
    // (G, sahibi) · ADM-04 (L, süper admin).
    // Kapalı kalan dal: U süper admin `status: 'resolved'`, `action`, `resolvedAt`, `resolvedBy` (T-37).
    // Sahibi şikayetini güncelleyemez: aynı hedefe ikinci `set` update sayılır ve reddedilir.
    match /reports/{reportId} {
      function ownReportId() {
        let prefix = uid() + '_';
        return reportId.size() > prefix.size() && reportId[0:prefix.size()] == prefix;
      }

      // Hedef belge VAR olmalı ve `targetClubId` (ADM-04 bağlamı, CD-33) hedefin gerçek kulübü olmalıdır:
      // kullanıcı hedefinde yok; kulüp hedefinde hedefin kendisi; gönderi / yorum / etkinlik hedefinde hedef
      // belgenin `clubId` alanı. Aksi halde aktif bir hesap olmayan hedeflere, dilediği kulübe atfedilmiş
      // sınırsız (ve istemciden silinemeyen) açık şikayet yazabilir (CD-137 madde 8u). 1 erişim yolu: hedef.
      function contentClub(coll, id) { return get(/databases/$(database)/documents/$(coll)/$(id)).data.clubId; }
      function targetOk(d) {
        return (d.targetType == 'user' && d.get('targetClubId', null) == null && exists(userPath(d.targetId)))
            || (d.targetType == 'club' && d.targetClubId == d.targetId && exists(clubPath(d.targetId)))
            || (d.targetType == 'post' && d.targetClubId is string && contentClub('posts', d.targetId) == d.targetClubId)
            || (d.targetType == 'comment' && d.targetClubId is string && contentClub('comments', d.targetId) == d.targetClubId)
            || (d.targetType == 'event' && d.targetClubId is string && contentClub('events', d.targetId) == d.targetClubId);
      }

      function canCreateReport() {
        let d = request.resource.data;
        return activeUser()
            && d.keys().hasOnly(['targetType', 'targetId', 'targetClubId', 'reporterId', 'reason', 'note',
                                 'status', 'action', 'resolvedAt', 'resolvedBy',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.reporterId == uid()
            // ReportTargetType (5 — CD-33)
            && d.targetType in ['post', 'comment', 'user', 'club', 'event']
            && d.targetId is string && d.targetId.size() > 0
            && reportId == d.reporterId + '_' + d.targetType + '_' + d.targetId
            // kendi kendini şikayet yok
            && (d.targetType != 'user' || d.targetId != uid())
            && targetOk(d)
            // ReportReason (6 — CD-33)
            && d.reason in ['spam', 'harassment', 'inappropriate', 'misinformation', 'offtopic', 'other']
            && d.note is string && d.note.size() <= 300   // limit: reportNoteMax
            && d.status == 'open'
            && d.get('action', null) == null && d.get('resolvedAt', null) == null
            && d.get('resolvedBy', null) == null;
      }

      // R — sahibi (aktif kullanıcı; askıdaki / silinmiş hesap okuyamaz) ve süper admin. Olmayan kendi
      // şikayetinin tekil okuması boş döner (hasReported → false).
      allow get: if isSuper() || (activeUser() && ((resource == null && ownReportId()) || resource.data.reporterId == uid()));
      allow list: if isSuper() || (activeUser() && resource.data.reporterId == uid());
      allow create: if canCreateReport();
      allow update: if false;
      allow delete: if false;
    }

    // 13 · activity/{activityId} — T-15 · T-19 (gönderi yayını) · T-22 (etkinlik yayını / iptali) ·
    // yönetici türleri T-30 · rules-spec §3.11
    // Değiştirilemez günlük: BaseFields YOK (yalnızca `createdAt`), update ve delete herkese kapalı.
    // Yazma yolu: ActivityRepository.addToBatch — asıl yazımla AYNI batch'te (apply / joinInstant / leave;
    // T-19: PostRepository.create; T-22: EventRepository.create / publish / cancel).
    // Kapalı kalan türler: `application_approved`, `application_rejected`, `member_removed`, `role_changed`,
    // `settings_changed` (yazan yönetici / süper admin — T-30, T-37).
    match /activity/{activityId} {
      // `refs` (ActivityRefsModel): üyelik türlerinde yalnızca `userId` (= oturum); diğerleri yok / null.
      function ownRefs(r) {
        return r is map && r.keys().hasOnly(['userId', 'eventId', 'postId', 'role'])
            && r.userId == uid()
            && r.get('eventId', null) == null && r.get('postId', null) == null && r.get('role', null) == null;
      }

      // C (T-15) — oturumun KENDİ üyelik geçişinin günlüğü; geçiş aynı batch'teki üyelik yazımından
      // doğrulanır (yazım-öncesi ≠ yazım-sonrası durum): `application_received` ⇒ → `pending` (M1 / M3 / M4) ·
      // `member_joined` ⇒ → `active` (M2 / M3) · `member_left` ⇒ `active` → `left` (M8).
      // Belge kimliği SABİTTİR (FirestoreIds.activity): `{clubId}_{uid}_{kind}_{priorCount}` — `priorCount`
      // yazım-sonrası üyelikten okunur. Bir geçişin (tür, priorCount) çifti tekildir (her yeniden başvuru /
      // katılım sayacı bir artırır): aynı geçişe ikinci günlük aynı kimliğe düşer, update sayılır ve
      // reddedilir. Serbest kimlikle tek batch'e yüzlerce sahte satır yazılabiliyordu (CD-137 madde 8t).
      // 1 erişim yolu: memberships/{clubId}_{uid} (getAfter + exists / get).
      function canLogOwnMembership() {
        let d = request.resource.data;
        let ref = mPath(d.clubId, uid());
        let after = getAfter(ref).data;
        let now = after.status;
        let was = exists(ref) ? get(ref).data.status : 'none';
        return d.keys().hasOnly(['clubId', 'actorId', 'kind', 'refs', 'createdAt'])
            && d.createdAt == request.time
            && d.actorId == uid()
            && d.clubId is string && d.kind is string
            && activityId == d.clubId + '_' + uid() + '_' + d.kind + '_' + string(after.get('priorCount', 0))
            && ownRefs(d.refs)
            && ((d.kind == 'application_received' && now == 'pending' && was != 'pending')
                || (d.kind == 'member_joined' && now == 'active' && was != 'active')
                || (d.kind == 'member_left' && now == 'left' && was == 'active'));
      }

      // `refs`: gönderi türlerinde yalnızca `postId`; diğerleri yok / null.
      function postRefs(r) {
        return r is map && r.keys().hasOnly(['userId', 'eventId', 'postId', 'role'])
            && r.postId is string
            && r.get('userId', null) == null && r.get('eventId', null) == null && r.get('role', null) == null;
      }

      // C (T-19) — oturumun AYNI işlemde yayınladığı gönderinin günlüğü: `post_created` ⇒ `post`,
      // `announcement` ⇒ `announcement`, `poll` ⇒ `poll`. Gönderi yazım-öncesi YOKTUR, yazım-sonrası vardır,
      // bu kulübündür ve yazarı oturumdur (yayın yetkisini — yönetici, aktif hesap, askıda olmayan kulüp —
      // gönderi kuralı doğrular; burada yeniden okunmaz). Belge kimliği SABİTTİR (FirestoreIds.postActivity):
      // `{clubId}_{uid}_{kind}_{postId}` — bir yayına tek günlük düşer; serbest kimlik, ikinci kayıt ve
      // sonradan yeniden yazım reddedilir (CD-137 madde 8t). 1 erişim yolu: gönderi (exists + getAfter).
      function canLogOwnPost() {
        let d = request.resource.data;
        let ref = postPath(d.refs.postId);
        let p = getAfter(ref).data;
        return d.kind in ['post_created', 'announcement', 'poll']
            && d.keys().hasOnly(['clubId', 'actorId', 'kind', 'refs', 'createdAt'])
            && d.createdAt == request.time
            && d.actorId == uid()
            && d.clubId is string
            && postRefs(d.refs)
            && activityId == d.clubId + '_' + uid() + '_' + d.kind + '_' + d.refs.postId
            && !exists(ref)
            && p.clubId == d.clubId && p.authorId == uid()
            && ((d.kind == 'post_created' && p.type == 'post')
                || (d.kind == 'announcement' && p.type == 'announcement')
                || (d.kind == 'poll' && p.type == 'poll'));
      }

      // `refs`: etkinlik türlerinde yalnızca `eventId`; diğerleri yok / null.
      function eventRefs(r) {
        return r is map && r.keys().hasOnly(['userId', 'eventId', 'postId', 'role'])
            && r.eventId is string
            && r.get('userId', null) == null && r.get('postId', null) == null && r.get('role', null) == null;
      }

      // C (T-22) — oturumun AYNI işlemde yaptığı etkinlik geçişinin günlüğü. Geçişi (yönetici, aktif hesap,
      // askıda olmayan kulüp) etkinlik kuralı yetkilendirir; burada yazım-sonrası etkinliğin bu kulübün olduğu
      // ve geçişin BU işlemde yapıldığı görülür:
      //   `event_published` ⇒ sonra `published` ve `publishedAt == request.time` (yayın bu işlemde), önce belge
      //     yok ya da `publishedAt` boş — yalnızca İLK yayın günlüğe düşer (yayından çekilip yeniden yayınlanan
      //     etkinlik ikinci kayıt üretmez);
      //   `event_cancelled` ⇒ önce `published`, sonra `cancelled`.
      // Belge kimliği SABİTTİR (FirestoreIds.eventActivity): `{clubId}_{uid}_{kind}_{eventId}` — serbest kimlik,
      // ikinci kayıt ve sonradan yeniden yazım reddedilir (CD-137 madde 8t).
      // 1 erişim yolu: etkinlik (getAfter + exists / get).
      function canLogOwnEvent() {
        let d = request.resource.data;
        let ref = eventPath(d.refs.eventId);
        let e = getAfter(ref).data;
        return d.kind in ['event_published', 'event_cancelled']
            && d.keys().hasOnly(['clubId', 'actorId', 'kind', 'refs', 'createdAt'])
            && d.createdAt == request.time
            && d.actorId == uid()
            && d.clubId is string
            && eventRefs(d.refs)
            && activityId == d.clubId + '_' + uid() + '_' + d.kind + '_' + d.refs.eventId
            && e.clubId == d.clubId
            && ((d.kind == 'event_published' && e.status == 'published' && e.publishedAt == request.time
                 && (!exists(ref) || get(ref).data.get('publishedAt', null) == null))
                || (d.kind == 'event_cancelled' && e.status == 'cancelled' && get(ref).data.status == 'published'));
      }

      // R — kulüp yönetimi, danışman (ikisi de aktif hesap) ve süper admin; doğrulanmış e-posta şarttır
      // (`seesMgmt`). Sorgu `clubId` süzgecini taşır (rules-spec §6 MGT-10).
      allow read: if seesMgmt(resource.data.clubId);
      allow create: if canLogOwnMembership() || canLogOwnPost() || canLogOwnEvent();
      allow update: if false;
      allow delete: if false;
    }

    // 14 · settings/{uid} — T-12 · rules-spec §3.12
    // Yazma yolları: UserRepository.createProfile / SettingsRepository.getSettings (C, varsayılanlar) ·
    // updateSettings · updateClubSettings (U). BaseFields YOK (yalnızca `updatedAt`); soft delete yok.
    match /settings/{uid} {
      // `uid` = yol değişkeni (`match /settings/{uid}`), `request.auth.uid` = oturum kimliği.
      function isOwner() { return emailOk() && request.auth.uid == uid; }

      // Sonuç belge: on bir alanın tamamı vardır ve tipleri doğrudur.
      function settingsShape() {
        let d = request.resource.data;
        return d.announcements is bool && d.eventReminders is bool && d.newEvents is bool
            && d.applicationResults is bool && d.management is bool && d.system is bool
            // CD-34: `none` ve `15m` yalnızca rsvps.reminder içindir
            && d.reminderTime in ['1h', '1d']
            && d.quiet is bool
            && d.quietFrom is string && d.quietFrom.matches('^([01]\\d|2[0-3]):[0-5]\\d$')   // limit: timeOfDayPattern
            && d.quietTo is string && d.quietTo.matches('^([01]\\d|2[0-3]):[0-5]\\d$')   // limit: timeOfDayPattern
            // anahtar = clubId, değer = ClubNotificationPrefsModel; belge yalnızca sahibine açıktır
            && d.clubs is map
            && d.updatedAt == request.time;
      }

      function canCreateSettings() {
        return isOwner()
            && request.resource.data.keys().hasOnly(['announcements', 'eventReminders', 'newEvents',
                                                     'applicationResults', 'management', 'system',
                                                     'reminderTime', 'quiet', 'quietFrom', 'quietTo',
                                                     'clubs', 'updatedAt'])
            && settingsShape();
      }

      function canUpdateSettings() {
        return isOwner()
            && touches(['announcements', 'eventReminders', 'newEvents', 'applicationResults',
                        'management', 'system', 'reminderTime', 'quiet', 'quietFrom', 'quietTo', 'clubs'])
            && settingsShape();
      }

      // R — yalnızca sahibi (süper admin dahil başkası okuyamaz).
      allow get: if isOwner();
      allow list: if false;
      allow create: if canCreateSettings();
      allow update: if canUpdateSettings();
      allow delete: if false;
    }

    // 15 · blocks/{blockerId}_{blockedId} — T-15 · rules-spec §3.13
    // Yazma yolları: BlockRepository.block (C; belge varsa restore) · softDeleteBlock (engeli kaldır) ·
    // restoreBlock (yeniden engelle / Geri al). Engellenen kullanıcı belgeyi okuyamaz (engellendiğini
    // öğrenemez); süper admin dahil başkası okuyamaz, yazamaz.
    match /blocks/{blockId} {
      function ownBlockId() {
        let prefix = uid() + '_';
        return blockId.size() > prefix.size() && blockId[0:prefix.size()] == prefix;
      }

      function canCreateBlock() {
        let d = request.resource.data;
        return activeUser()
            && d.keys().hasOnly(['blockerId', 'blockedId',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.blockerId == uid()
            && d.blockedId is string && d.blockedId.size() > 0
            // kendini engelleme yok
            && d.blockedId != uid()
            && blockId == d.blockerId + '_' + d.blockedId;
      }

      // U — yalnızca soft delete (engeli kaldır) ve restore (yeniden engelle); `blockerId` / `blockedId`
      // değişemez. Askıdaki / silinmiş hesap yazamaz (PLAN §11.1 satır 15 susp/del).
      function canToggleBlock() {
        return activeUser() && resource.data.blockerId == uid() && (isSoftDelete([]) || isRestore([]));
      }

      // R — yalnızca engelleyen (silinmiş = kaldırılmış engel dahil: `block()` yeniden engellerken okur).
      // Olmayan kendi belgesinin tekil okuması boş döner. Sorgu `blockerId == uid` süzgecini taşır.
      allow get: if emailOk() && ((resource == null && ownBlockId()) || resource.data.blockerId == uid());
      allow list: if emailOk() && resource.data.blockerId == uid();
      allow create: if canCreateBlock();
      allow update: if canToggleBlock();
      allow delete: if false;
    }

    // 16 · savedPosts/{userId}_{postId} — T-19 · rules-spec §3.14
    // Yazma yolları: SavedPostRepository.save (C; silinmiş kayıt varsa restore + `savedAt` yenilenir) ·
    // softDeleteSaved (kaldır) · restoreSaved (Geri al; `savedAt` değişmez). Kayıt yalnızca sahibine
    // açıktır: süper admin dahil başkası okuyamaz, yazamaz. Yol oturumdan türetilir (`{uid}_{postId}`).
    match /savedPosts/{savedPostId} {
      function ownSavedId() {
        let prefix = uid() + '_';
        return savedPostId.size() > prefix.size() && savedPostId[0:prefix.size()] == prefix;
      }

      // C — gönderiyi görebilen aktif kullanıcı (üye, yönetim, danışman, süper admin), kendi adına;
      // `clubId` gönderinin kulübüdür; gönderi silinmemiş ve gizli değildir.
      // 3 erişim yolu: gönderi · users/{uid} · üyelik.
      function canSavePost() {
        let d = request.resource.data;
        let p = get(postPath(d.postId)).data;
        return d.keys().hasOnly(['userId', 'postId', 'clubId', 'savedAt',
                                 'createdAt', 'updatedAt', 'isDeleted', 'deletedAt', 'deletedBy'])
            && baseCreate()
            && d.userId == uid()
            && d.postId is string && d.clubId is string
            && savedPostId == d.userId + '_' + d.postId
            && d.savedAt == request.time
            && p.clubId == d.clubId && p.isDeleted == false && p.isHidden == false
            && activeUser() && seesInside(d.clubId);
      }

      // U — yalnızca soft delete (kaldır) ve restore (Geri al / yeniden kaydet). `userId`, `postId`,
      // `clubId` değişemez. Yeniden kaydetmede `savedAt` sunucu zamanına yenilenir; Geri al'da dokunulmaz.
      // Üyelik aranmaz: kulüpten ayrılan kullanıcı listesini temizleyebilir (gönderiyi zaten okuyamaz).
      // Askıdaki / silinmiş hesap yazamaz.
      function canToggleSaved() {
        let d = request.resource.data;
        return activeUser() && resource.data.userId == uid()
            && (isSoftDelete([])
                || (isRestore(['savedAt']) && (d.savedAt == resource.data.savedAt || d.savedAt == request.time)));
      }

      // R — yalnızca sahibi (kaldırılmış kayıt dahil: `save()` yeniden kaydederken okur). Olmayan kendi
      // kaydının tekil okuması boş döner (isSaved → false). Sorgu `userId == uid` süzgecini taşır.
      allow get: if emailOk() && ((resource == null && ownSavedId()) || resource.data.userId == uid());
      allow list: if emailOk() && resource.data.userId == uid();
      allow create: if canSavePost();
      allow update: if canToggleSaved();
      allow delete: if false;
    }

    // 17 · supportTickets/{ticketId} — T-28
    match /supportTickets/{ticketId} {
      allow read: if false;
      allow create, update: if false;
      allow delete: if false;
    }

    // 18 · announcementCounters/{clubId}_{yyyyMMdd} — T-19 · rules-spec §3.16 (Q-10, CD-129)
    // Günlük bildirimli duyuru sayacı. Alanlar: `clubId`, `day` (`yyyy-MM-dd`), `count`, `lastPostRef`,
    // `updatedAt` (BaseFields yok; belge silinmez ve sıfırlanmaz — yeni gün yeni belgedir).
    // Yazma yolu: PostRepository.create — YALNIZCA bildirimli duyuru yayınıyla aynı işlemde (`set(merge)`).
    match /announcementCounters/{counterId} {
      // Olmayan sayacın tekil okumasında kulüp kimliği belge kimliğinden çıkarılır (`_yyyyMMdd` eki atılır).
      function counterClub() { return counterId[0:counterId.size() - '_yyyyMMdd'.size()]; }

      // C / U ortak koşulları (PLAN §11.2b): sayaç bugünün (Istanbul, sunucu saati) belgesidir, günde en çok
      // iki bildirimli duyuruya izin verir ve işaretçisi AYNI işlemde oluşturulan, bu kulübün, oturumun
      // yazdığı bildirimli duyuruyu gösterir. Gönderi kuralı da bu belgenin tam +1 oynadığını ve kendisini
      // gösterdiğini görür (iki yönlü bağ): sayaç tek başına ya da başka türde bir gönderiyle yazılamaz.
      // İşaretçi rastgele gönderi kimliğidir; belgeyi yalnızca `seesMgmt` okur.
      // 3 erişim yolu: users/{uid} · üyelik · gönderi.
      function announcedNow(p, c) {
        return p.clubId == c && p.authorId == uid() && p.type == 'announcement' && p.pushSent == true;
      }
      function counterShapeOk() {
        let d = request.resource.data;
        let ref = d.get('lastPostRef', null);
        return d.clubId is string
            && counterId == d.clubId + '_' + istanbulDayKey()
            && d.day == istanbulDay()
            && d.count is int && d.count <= 2   // limit: announcementDailyLimit
            && ref is string && ref.matches('posts/[A-Za-z0-9_-]+')
            && !exists(postPath(ref.split('/')[1]))
            && announcedNow(getAfter(postPath(ref.split('/')[1])).data, d.clubId)
            && activeUser() && isManager(d.clubId);
      }
      function canOpenCounter() {
        let d = request.resource.data;
        return d.keys().hasOnly(['clubId', 'day', 'count', 'lastPostRef', 'updatedAt'])
            && d.updatedAt == request.time
            && d.count == 1
            && counterShapeOk();
      }
      function canBumpCounter() {
        return touches(['count', 'lastPostRef'])
            && request.resource.data.count == resource.data.count + 1
            && counterShapeOk();
      }

      // R — kulüp yönetimi, danışman (aktif hesap) ve süper admin (FED-03 hak çubuğu). Olmayan sayacın
      // tekil okuması o kulübün yönetimine boş döner (getToday → null: o gün bildirimli duyuru yok).
      allow get: if resource == null
                    ? (counterId.matches('.+_[0-9]{8}') && seesMgmt(counterClub()))
                    : seesMgmt(resource.data.clubId);
      allow list: if seesMgmt(resource.data.clubId);
      allow create: if canOpenCounter();
      allow update: if canBumpCounter();
      allow delete: if false;
    }

    // ── Koleksiyon grupları ─────────────────────────────────────────────────────────────────────

    // collectionGroup('private') — ADM-05 e-posta araması, yalnızca süper admin (T-37). Bu ad altında üç belge
    // türü durur (`users/…/private/account`, `memberships/…/private/contact`, `events/…/private/counter`).
    match /{path=**}/private/{docId} {
      allow read: if false;
    }

    // collectionGroup('votes') — kullanılmaz; açıkça kapalı.
    match /{path=**}/votes/{voterId} {
      allow read: if false;
    }

    // ── Varsayılan ret (docs/firestore-rules-spec.md §1.1): yukarıda açılmayan her yol kapalıdır ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
