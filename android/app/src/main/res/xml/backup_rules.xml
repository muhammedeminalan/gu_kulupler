<?xml version="1.0" encoding="utf-8"?>
<!-- T-45 (A3-01), API ≤ 30: allowBackup="false" yedeği zaten kapatır; bu dosya ikinci önlemdir
     (bir eklenti allowBackup'ı ezerse de oturum, önbellek ve tercihler yedeğe girmez). -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
